@using TaskManagement.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userName =
        ViewData["UserName"]?.ToString()
        ?? User.Identity?.Name
        ?? "User";

    var firstLetter =
        string.IsNullOrWhiteSpace(userName)
            ? "U"
            : userName.Substring(0, 1).ToUpper();

    var profilePhoto = currentUser?.ProfilePictureUrl;
}

<header class="topbar">

    <div class="search">

        <span class="search-icon">
            ⌕
        </span>

        <input type="text"
               id="globalSearch"
               placeholder="Search tasks..." />

        <kbd>Ctrl K</kbd>

    </div>


    <div class="top-actions">

        <!-- THEME -->

        <button type="button"
                class="round-button"
                id="themeButton"
                aria-label="Change theme">

            ☼

        </button>


        <!-- NOTIFICATIONS -->

        <button type="button"
                class="round-button notification-button"
                id="notificationButton"
                aria-label="Notifications">

            <span class="notification-icon-glyph">
                🔔
            </span>

        </button>

        <!-- CHAT -->

        <button type="button"
                class="round-button chat-button"
                id="chatButton"
                aria-label="Chat">

            <span class="chat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                    <path d="M6.5 5.25h11A3.25 3.25 0 0 1 20.75 8.5v5.25A3.25 3.25 0 0 1 17.5 17H11l-4.75 3v-3.18A3.25 3.25 0 0 1 3.25 13.75V8.5A3.25 3.25 0 0 1 6.5 5.25Z"></path>
                    <path d="M8 9.5h8M8 12.5h5" class="chat-icon-lines"></path>
                </svg>
            </span>
            <span id="globalChatBadge" class="chat-badge" style="display:none;" aria-label="Unread chat messages"></span>

        </button>


        <!-- USER -->

        <button type="button"
                class="user-button"
                data-modal="profileModal">

            <span class="user-avatar @(string.IsNullOrWhiteSpace(profilePhoto) ? "" : "has-photo")">
                @if (!string.IsNullOrWhiteSpace(profilePhoto))
                {
                    <img src="@profilePhoto" alt="Profile picture" />
                }
                else
                {
                    @firstLetter
                }
            </span>

            <span class="user-info">

                <strong>
                    @userName
                </strong>

                <small>
                    Student
                </small>

            </span>

            <span class="chevron">
                ⌄
            </span>

        </button>

    </div>

</header>
<script src="~/js/users/user-realtime.js" asp-append-version="true"></script>
