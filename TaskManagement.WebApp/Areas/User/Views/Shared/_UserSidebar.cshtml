@{
    var currentPath = Context.Request.Path.Value?.TrimEnd('/');

    var dashboardActive =
        string.Equals(
            currentPath,
            "/User/Dashboard",
            StringComparison.OrdinalIgnoreCase);

    var myTasksActive =
        string.Equals(
            currentPath,
            "/User/MyTasks",
            StringComparison.OrdinalIgnoreCase);

    var notificationsActive =
        currentPath?.StartsWith(
            "/User/Notifications",
            StringComparison.OrdinalIgnoreCase) == true;

    var paymentDetailsActive =
        currentPath?.StartsWith(
            "/User/PaymentDetails",
            StringComparison.OrdinalIgnoreCase) == true;
}

<aside class="sidebar">

    <div class="brand">
        <img src="~/images/ciit-logo.png"
             alt="CIIT Training Institute"
             class="sidebar-brand-image" />
    </div>

    <nav class="navigation">

        <a href="@Url.Action("Index", "Dashboard", new { area = "User" })"
           class="nav-link @(dashboardActive ? "active" : "")">
            <span class="nav-symbol">⌂</span>
            <span>Dashboard</span>
        </a>

        <a href="@Url.Action("Index", "MyTasks", new { area = "User" })"
           class="nav-link @(myTasksActive ? "active" : "")">
            <span class="nav-symbol">✓</span>
            <span>My Tasks</span>
        </a>

        <a href="@Url.Action("Index", "Notifications", new { area = "User" })"
           class="nav-link @(notificationsActive ? "active" : "")">
            <span class="nav-symbol">🔔</span>
            <span>Notifications</span>
        </a>

        <a href="@Url.Action("Index", "PaymentDetails", new { area = "User" })"
           class="nav-link @(paymentDetailsActive ? "active" : "")">
            <span class="nav-symbol">▣</span>
            <span>Payment Details</span>
        </a>

        <a href="@Url.Action("Index", "Profile", new { area = "User" })"
           class="nav-link @(currentPath?.StartsWith("/User/Profile", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")">
            <span class="nav-symbol">♙</span>
            <span>Profile</span>
        </a>

        <button type="button"
                class="nav-link"
                data-modal="settingsModal">
            <span class="nav-symbol">⚙</span>
            <span>Settings</span>
        </button>

    </nav>

    <div class="sidebar-bottom">

        <div class="sidebar-message">
            <span>✦</span>
            <p>
                Small steps every day
                create big results.
            </p>
        </div>

        <form id="logoutForm"
              action="@Url.Action("Logout", "Account", new { area = "" })"
              method="post"
              class="logout-form">

            @Html.AntiForgeryToken()

            <button type="submit"
                    id="logoutButton"
                    class="logout-button">
                <span>↪</span>
                <span>Logout</span>
            </button>

        </form>

    </div>

</aside>
