<link rel="stylesheet" href="~/css/user-chat.css" asp-append-version="true" />

@*
    Global User Task Chat Drawer
    - Opens from the topbar chat/bell area or a task's "Chat with Admin" action.
    - User can only chat about their own task conversations.
*@

<div id="taskChatOverlay" class="task-chat-overlay"></div>

<aside id="taskChatDrawer" class="task-chat-drawer" aria-label="Task conversations">
    <div class="task-chat-container">

        <section class="task-chat-sidebar" aria-label="Task conversations list">
            <div class="task-chat-sidebar-header">
                <div>
                    <strong>Conversations</strong>
                    <small>Recent</small>
                </div>
            </div>

            <div id="userChatList" class="task-chat-conversations">
                <div class="task-chat-empty task-chat-list-empty">
                    <div class="task-chat-empty-icon">✦</div>
                    <p>No task conversations yet.</p>
                </div>
            </div>
        </section>

        <section class="task-chat-main">

            <header class="task-chat-header">
                <div class="task-chat-admin">
                    <div class="task-chat-avatar" aria-hidden="true">
                        <span>✦</span>
                    </div>

                    <div class="task-chat-header-copy">
                        <div id="chatTaskTitle" class="task-chat-title">Select a task</div>
                        <div class="task-chat-status">
                            <span class="status-dot"></span>
                            <span id="chatTaskStatus">Task chat</span>
                        </div>
                    </div>
                </div>

                <button type="button"
                        id="closeTaskChat"
                        class="task-chat-close"
                        aria-label="Close chat">
                    <span aria-hidden="true">×</span>
                </button>
            </header>

            <div id="taskChatMessages" class="task-chat-messages">
                <div class="task-chat-empty">
                    <div class="task-chat-empty-icon">✦</div>
                    <h4>Select a task</h4>
                    <p>Choose a task conversation from the left to view messages.</p>
                </div>
            </div>

            <div id="taskChatComposer" class="task-chat-composer" style="display:none;">
                <textarea id="taskChatInput"
                          rows="1"
                          maxlength="4000"
                          placeholder="Type a message..."
                          aria-label="Message"></textarea>

                <button type="button"
                        id="sendTaskChat"
                        class="task-chat-send"
                        aria-label="Send message"
                        disabled>
                    <span aria-hidden="true">➤</span>
                </button>
            </div>

            <button type="button"
                    id="startTaskChat"
                    class="task-chat-start"
                    style="display:none;">
                <span>✦</span>
                Start Task Chat
            </button>

        </section>
    </div>
</aside>
