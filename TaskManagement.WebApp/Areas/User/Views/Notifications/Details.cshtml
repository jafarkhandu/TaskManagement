@{
    Layout = null;

    var notificationType = Model.NotificationType?.ToString() ?? "TaskAssignment";
    var isReviewApproved = notificationType == "TaskReviewApproved";
    var isReviewRejected = notificationType == "TaskReviewRejected";
    var isPaymentSettled = notificationType == "TaskPaymentSettled";
    var isPaymentWithheld = notificationType == "TaskPaymentWithheld";
    var isReassignment = notificationType == "TaskAssignmentReassigned";
    var isDeadlineTomorrow = notificationType == "TaskDeadlineTomorrow";
    var isDeadlineToday = notificationType == "TaskDeadlineToday";
    var isDeadlineNotification = isDeadlineTomorrow || isDeadlineToday;
    var isTaskAssignment = notificationType == "TaskAssignment";
    var isReviewUpdate = isReviewApproved || isReviewRejected || isPaymentSettled || isPaymentWithheld || isReassignment;

    var detailTitle = isDeadlineTomorrow
        ? "Deadline Tomorrow"
        : isDeadlineToday
            ? "Deadline Today"
            : isPaymentSettled
                ? "Payment Settled"
                : isPaymentWithheld
                    ? "Payment Withheld"
                : isReviewApproved
                    ? "Task Review Approved"
                    : isReviewRejected
                        ? "Task Review Rejected"
                        : "New Task Assignment";

    var detailDescription = isDeadlineTomorrow
        ? "This task is due tomorrow."
        : isDeadlineToday
            ? "This task is due today."
            : isPaymentSettled
                ? "Your task review is complete and the payment has been settled."
                : isPaymentWithheld
                    ? "This task was submitted after the deadline and is not eligible for payment."
                : isReviewApproved
                    ? "Your submitted work has been reviewed and approved by the admin."
                    : isReviewRejected
                        ? "Your submitted work was rejected and the task has been placed on hold."
                        : "Review the task details below and choose to accept or reject.";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/ciit-logo.png" asp-append-version="true" />
    <title>TaskManager — Notification Details</title>
    <link rel="stylesheet"
      href="~/css/users/user-dashboard.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/users/notification-details.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/theme.css"
      asp-append-version="true" />
</head>

<div class="user-app-shell">

    <!-- COMMON USER SIDEBAR -->
    @await Html.PartialAsync(
        "~/Areas/User/Views/Shared/_UserSidebar.cshtml")

    <main class="main-content">

        <!-- COMMON USER TOPBAR -->
        @await Html.PartialAsync(
            "~/Areas/User/Views/Shared/_UserTopbar.cshtml")

            
 @await Html.PartialAsync(
    "~/Areas/User/Views/Shared/_UserModals.cshtml")


        <div class="task-details-page">

            <div class="task-details-glow task-details-glow-one"></div>
            <div class="task-details-glow task-details-glow-two"></div>

            <main class="task-details-shell">

                <!-- EVERYTHING BELOW REMAINS YOUR EXISTING CODE -->

                <section class="task-details-header">

                    <a href="/User/Notifications" class="task-back-link">
                        <span class="back-arrow">←</span>
                        <span>Back to Notifications</span>
                    </a>

                    <div class="task-header-content">

                        <div class="task-header-icon">
                            <span>🔔</span>
                        </div>

                        <div class="task-header-text">

                            <span class="task-eyebrow">
                                @(isTaskAssignment ? "TASK ASSIGNMENT" : isDeadlineNotification ? "DEADLINE ALERT" : "TASK UPDATE")
                            </span>

                            <h1>
                                @detailTitle
                            </h1>

                            <p>
                                @detailDescription
                            </p>

                        </div>

                    </div>

                </section>


                <section class="task-details-card">

                    <div class="task-details-card-inner">

                        <div class="task-information">

                            <div class="task-title-row">

                                <div>
                                    <h2>@Model.Title</h2>

                                    <span class="task-reference">
                                        #TASK-@Model.NotificationId
                                    </span>
                                </div>

                                @if (isTaskAssignment)
                                {
                                    <span class="priority-badge">
                                        <span class="priority-dot"></span>
                                        @Model.Priority Priority
                                    </span>
                                }

                            </div>


                            @if (isTaskAssignment)
                            {
                                <div class="task-scenario">

                                    <span class="detail-label">
                                        Scenario
                                    </span>

                                    <div class="scenario-box" id="scenarioPreviewBox">
                                        <span class="scenario-preview-text">@Model.Scenario</span>
                                        <button type="button" class="scenario-more-button" id="scenarioMoreButton" hidden>More...</button>
                                    </div>

                                </div>


                                <div class="task-info-grid">

                                    <div class="info-tile">
                                        <div class="info-icon">📅</div>
                                        <div>
                                            <span class="detail-label">Start Date</span>
                                            <strong>
                                                @(((DateTime)Model.StartDate).ToString("dd MMM yyyy"))
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="info-tile">
                                        <div class="info-icon">📅</div>
                                        <div>
                                            <span class="detail-label">Expected End Date</span>
                                            <strong>
                                                @(((DateTime)Model.ExpectedEndDate).ToString("dd MMM yyyy"))
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="info-tile">
                                        <div class="info-icon">₹</div>
                                        <div>
                                            <span class="detail-label">Amount</span>
                                            <strong>
                                                ₹@String.Format(
                                                    System.Globalization.CultureInfo.GetCultureInfo("en-IN"),
                                                    "{0:N2}",
                                                    Model.Amount
                                                )
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="info-tile">
                                        <div class="info-icon">⚑</div>
                                        <div>
                                            <span class="detail-label">Priority</span>
                                            <strong>@Model.Priority</strong>
                                        </div>
                                    </div>

                                    <div class="info-tile">
                                        <div class="info-icon">👤</div>
                                        <div>
                                            <span class="detail-label">Assigned By</span>
                                            <strong>Admin</strong>
                                        </div>
                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="notification-event-panel">
                                    <span class="detail-label">@(isDeadlineNotification ? "DEADLINE" : "UPDATE")</span>
                                    <h3>@Model.NotificationTitle</h3>
                                    <p>
                                        @(isReassignment
                                            ? "This assignment is no longer available for you. You cannot accept or reject this task."
                                            : isReviewRejected
                                                ? (string.IsNullOrWhiteSpace(Model.ReviewReason)
                                                    ? "Your submitted work was rejected by the admin."
                                                    : Model.ReviewReason)
                                                : isReviewApproved
                                                    ? "Your submitted work was approved by the admin."
                                                    : isPaymentSettled
                                                        ? "The task was completed and the payment was settled."
                                                        : isPaymentWithheld
                                                            ? "The task was completed, but no payment is due because the work was submitted after the deadline."
                                                            : "This task notification contains the latest update.")
                                    </p>
                                </div>
                            }

                        </div>


                        <aside class="task-action-panel">

                            <div class="action-panel-icon">
                                📄
                            </div>

                            <h3>@(isTaskAssignment ? "Task Details" : "Update Details")</h3>

                            <p class="action-panel-subtitle">
                                @(isTaskAssignment
                                    ? "Please review all the information before taking action."
                                    : "Here is the latest update for this task.")
                            </p>

                            @if (isTaskAssignment)
                            {
                                <div class="action-info-box">
                                    <span class="action-info-icon">ⓘ</span>
                                    <p>
                                        By accepting this task, it will be added to your
                                        active tasks and you will be responsible for
                                        completing it within the expected date.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="action-info-box notification-update-box @(isDeadlineNotification || isPaymentWithheld ? "payment-deadline-warning" : "")">
                                    <span class="action-info-icon">✦</span>
                                    <p>
                                        @(isDeadlineNotification
                                            ? "⚠ Submit this task before the deadline. No payment will be made after the deadline."
                                            : isPaymentWithheld
                                                ? "⚠ This task was submitted after the deadline and is no longer eligible for payment."
                                                : Model.NotificationTitle)
                                    </p>
                                </div>
                            }


                            <div class="task-actions">

                                <form id="antiForgeryForm">
                                    @Html.AntiForgeryToken()
                                </form>

                                @if (isReviewRejected)
                                {
                                    <div class="final-status rejected-status">
                                        <span>✕</span>
                                        Task On Hold
                                    </div>
                                    <div class="action-info-box">
                                        <span class="action-info-icon">ⓘ</span>
                                        <p>@Model.NotificationTitle</p>
                                    </div>
                                }
                                else if (isReviewApproved)
                                {
                                    <div class="final-status accepted-status">
                                        <span>✓</span>
                                        Task Review Approved
                                    </div>
                                }
                                else if (isPaymentSettled)
                                {
                                    <div class="final-status accepted-status">
                                        <span>₹</span>
                                        Payment Settled
                                    </div>
                                }
                                else if (isPaymentWithheld)
                                {
                                    <div class="final-status rejected-status">
                                        <span>₹</span>
                                        Payment Withheld
                                    </div>
                                }
                                else if (Model.AssignmentStatus == "Pending")
                                {
                                    <button type="button"
                                            id="rejectButton"
                                            class="task-action-button reject-button">
                                        <span>✕</span>
                                        <span>Reject</span>
                                    </button>

                                    <button type="button"
                                            id="acceptButton"
                                            class="task-action-button accept-button">
                                        <span>✓</span>
                                        <span>Accept</span>
                                    </button>
                                }
                                else if (Model.AssignmentStatus == "Accepted")
                                {
                                    <div class="final-status accepted-status">
                                        <span>✓</span>
                                        Task Accepted
                                    </div>
                                }
                                else if (Model.AssignmentStatus == "Rejected")
                                {
                                    <div class="final-status rejected-status">
                                        <span>✕</span>
                                        Task Rejected
                                    </div>
                                }
                                else if (Model.AssignmentStatus == "Reassigned")
                                {
                                    <div class="final-status rejected-status">
                                        <span>↗</span>
                                        Assignment Reassigned
                                    </div>
                                }

                            </div>

                        </aside>

                    </div>

                </section>

            </main>

        </div>

    </main>

</div>


<div class="notification-scenario-overlay" id="notificationScenarioModal" hidden aria-hidden="true">
    <div class="notification-scenario-dialog" role="dialog" aria-modal="true" aria-labelledby="notificationScenarioTitle">
        <div class="notification-scenario-header">
            <div>
                <span class="scenario-modal-eyebrow">TASK SCENARIO</span>
                <h5 id="notificationScenarioTitle">Scenario Details</h5>
            </div>
            <button type="button" class="scenario-modal-close" id="notificationScenarioClose" aria-label="Close">×</button>
        </div>
        <div class="notification-scenario-body">
            <div id="notificationScenarioFullText" class="notification-scenario-full-text"></div>
        </div>
    </div>
</div>

<script>
    window.notificationDetails = {
        assignmentId: @Model.AssignmentId,
        notificationId: @Model.NotificationId
    };
</script>

<script src="~/js/users/notification-details.js"
        asp-append-version="true"></script>

<script src="~/js/users/user-dashboard.js"
        asp-append-version="true"></script>

