@{
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Simple Notifications List Page *@

<div class="page-header">
	<a href="/User/Dashboard" class="back-link">← Dashboard</a>
	<h1>Notifications</h1>
</div>

<div class="notifications-list" id="notificationsList" aria-live="polite">
