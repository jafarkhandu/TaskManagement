@model TaskManagement.Application.DTOs.UserDashboardViewModel

@{
    Layout = null;

    var firstLetter = string.IsNullOrWhiteSpace(Model.UserName)
        ? "U"
        : Model.UserName.Substring(0, 1).ToUpper();

    var total = Math.Max(Model.TotalTasks, 1);

    var pendingPercent = Model.PendingTasks * 100.0 / total;
    // Review Pending tasks are active work too, so keep the dashboard count
    // consistent with the My Tasks "In Progress / Review" column.
    var dashboardInProgressTasks = Math.Max(
        Model.TotalTasks - Model.CompletedTasks - Model.PendingTasks - Model.OnHoldTasks,
        0);

    var progressPercent = dashboardInProgressTasks * 100.0 / total;
    var holdPercent = Model.OnHoldTasks * 100.0 / total;
    var completedPercent = Model.CompletedTasks * 100.0 / total;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/ciit-logo.png" asp-append-version="true" />

    <title>TaskManager — Dashboard</title>

    <link rel="stylesheet"
      href="~/css/users/user-dashboard.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/theme.css"
      asp-append-version="true" />

</head>

<body>

    @Html.AntiForgeryToken()

<div class="dashboard-shell">

    <!-- ================= SIDEBAR ================= -->
        @await Html.PartialAsync(
            "~/Areas/User/Views/Shared/_UserSidebar.cshtml")


    <!-- ================= MAIN ================= -->

    <main class="main-content"
          id="dashboard">


            @{
                ViewData["UserName"] = Model.UserName;
            }

            @await Html.PartialAsync(
                "~/Areas/User/Views/Shared/_UserTopbar.cshtml")


        <!-- NOTIFICATION -->

     

        <!-- ================= HERO ================= -->

        <section class="hero">

            <div class="hero-photo"></div>

            <div class="hero-shade"></div>

            <div class="hero-content">

                <span class="hero-small" id="dashboardGreeting">
                    Good Morning,
                </span>

                <h1>
                    @Model.UserName
                    <span>👋</span>
                </h1>

                <p>
                    Focus on progress, not perfection.
                </p>

            </div>


            <div class="hero-glass">

                <span class="quotation">
                    “
                </span>

                <strong id="dashboardQuote"></strong>
                <small id="dashboardQuoteAuthor"></small>

                      </div>

                 </section>


        <!-- ================= STATS ================= -->

        <section class="stats">

            <button class="stat"
                    data-stat="all">

                <span class="stat-icon blue">
                    ✓
                </span>

                <span class="stat-data">

                    <strong>
                        @Model.TotalTasks
                    </strong>

                    <small>
                        Total Tasks
                    </small>

                </span>

                <b>›</b>

            </button>


            <button class="stat"
                    data-stat="progress">

                <span class="stat-icon purple">
                    ◯
                </span>

                <span class="stat-data">

                    <strong>
                        @dashboardInProgressTasks
                    </strong>

                    <small>
                        In Progress
                    </small>

                </span>

                <b>›</b>

            </button>


            <button class="stat"
                    data-stat="completed">

                <span class="stat-icon green">
                    ✓
                </span>

                <span class="stat-data">

                    <strong>
                        @Model.CompletedTasks
                    </strong>

                    <small>
                        Completed
                    </small>

                </span>

                <b>›</b>

            </button>


            <button class="stat"
                    data-stat="hold">

                <span class="stat-icon pink">
                    ◷
                </span>

                <span class="stat-data">

                    <strong>
                        @Model.OnHoldTasks
                    </strong>

                    <small>
                        On Hold
                    </small>

                </span>

                <b>›</b>

            </button>

        </section>


        <!-- ================= CONTENT ================= -->

        <section class="content-grid">


                <!-- ================= TASK OVERVIEW ================= -->

                <article class="glass-card overview">

                    <div class="card-heading">

                        <div>
                            <span>PRODUCTIVITY</span>
                            <h2>Task Overview</h2>
                        </div>

                        <button type="button"
                                id="resetFilter">
                            This Project⌄
                        </button>

                    </div>


                    <div class="overview-dashboard">

                        <!-- ================= DONUT ================= -->

                        <div class="overview-chart-area">

                            <div class="overview-donut-wrap">

                                <div class="donut"
                                     style="
                                    --progress:@progressPercent%;
                                    --hold:@holdPercent%;
                                    --completed:@completedPercent%;
                                    ">

                                    <div class="donut-center">

                                        <strong>
                                            @Model.TotalTasks
                                        </strong>

                                        <small>
                                            Total Tasks
                                        </small>

                                    </div>

                                </div>

                                <div class="donut-glow"></div>

                            </div>


                            <div class="completion-summary">

                                <strong>
                                    @{
                                        var completionRate =
                                            Model.TotalTasks > 0
                                                ? Math.Round(
                                                    Model.CompletedTasks * 100.0 /
                                                    Model.TotalTasks)
                                                : 0;
                                    }

                                    @completionRate%
                                </strong>

                                <span>Completed</span>

                            </div>

                        </div>


                        <!-- ================= STATUS ================= -->

                        <div class="overview-status-grid">

                            <div class="overview-status todo">

                                <span class="status-dot"></span>

                                <div>
                                    <small>To Do</small>
                                    <strong>
                                        @Model.PendingTasks
                                    </strong>
                                </div>

                            </div>


                            <div class="overview-status in-progress">

                                <span class="status-dot"></span>

                                <div>
                                    <small>In Progress</small>
                                    <strong>
                                        @dashboardInProgressTasks
                                    </strong>
                                </div>

                            </div>


                            <div class="overview-status hold">

                                <span class="status-dot"></span>

                                <div>
                                    <small>On Hold</small>
                                    <strong>
                                        @Model.OnHoldTasks
                                    </strong>
                                </div>

                            </div>


                            <div class="overview-status completed">

                                <span class="status-dot"></span>

                                <div>
                                    <small>Completed</small>
                                    <strong>
                                        @Model.CompletedTasks
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <!-- ================= PROGRESS ================= -->

                        <div class="overview-progress">

                            <div class="overview-progress-head">

                                <span>
                                    Overall Progress
                                </span>

                                <strong>
                                    @completionRate%
                                </strong>

                            </div>


                            <div class="overview-progress-track">

                                <span style="width:@completionRate%"></span>

                            </div>

                        </div>


                        <!-- ================= DEADLINE HEALTH ================= -->

                        <div class="overview-progress deadline-health-progress">

                            <div class="overview-progress-head">

                                <span>
                                    Deadline Health
                                </span>

                                <strong>
                                    @Model.DeadlineHealthPercent%
                                </strong>

                            </div>


                            <div class="overview-progress-track deadline-health-track">

                                <span style="width:@Model.DeadlineHealthPercent%"></span>

                            </div>

                        </div>


                        <!-- ================= INSIGHT ================= -->

                        <div class="overview-insight">

                            <span class="insight-icon">
                                ✦
                            </span>

                            <div>

                                @if (Model.CompletedTasks > 0)
                                {
                                    <strong>
                                        Keep the momentum going
                                    </strong>

                                    <small>
                                        @Model.CompletedTasks task(s) completed so far.
                                    </small>
                                }
                                else if (dashboardInProgressTasks > 0)
                                {
                                    <strong>
                                        You're making progress
                                    </strong>

                                    <small>
                                        @dashboardInProgressTasks task(s) currently in progress.
                                    </small>
                                }
                                else if (Model.PendingTasks > 0)
                                {
                                    <strong>
                                        Ready when you are
                                    </strong>

                                    <small>
                                        @Model.PendingTasks task(s) waiting for you.
                                    </small>
                                }
                                else
                                {
                                    <strong>
                                        You're all caught up
                                    </strong>

                                    <small>
                                        No active tasks right now.
                                    </small>
                                }

                            </div>

                        </div>

                    </div>

                </article>

            <!-- FOCUS TASKS -->

            <article class="glass-card focus">

                <div class="card-heading">

                    <div>
                        <span>PRIORITY</span>
                        <h2>My Focus Tasks</h2>
                    </div>

                    <button type="button"
                            id="showAllTasks">

                        View All →

                    </button>

                </div>


                <div class="task-list">

                    @if (Model.FocusTasks.Any())
                    {
                        foreach (var task in Model.FocusTasks)
                        {
                            <button type="button"
                                    class="task-item"
                                    data-status="@task.Status"
                                    data-title="@task.Title"
                                    data-id="@task.Id">

                                <span class="task-circle"></span>

                                <span class="task-text">

                                    <strong>
                                        @task.Title
                                    </strong>

                                        <small>
                                            @task.Scenario
                                        </small>

                                </span>

                                <em class="@task.Priority.ToLowerInvariant()">
                                    @task.Priority
                                </em>

                                <time>
                                    @task.ExpectedEndDate.ToString("dd MMM")
                                </time>

                            </button>
                        }
                    }
                    else
                    {
                        <div class="empty">

                            <span>✓</span>

                            <strong>
                                You're all caught up
                            </strong>

                            <small>
                                No pending tasks.
                            </small>

                        </div>
                    }

                </div>

            </article>


            <!-- RECENT ACTIVITY -->

            <article class="glass-card activity">

                <div class="card-heading">

                    <div>
                        <span>UPDATES</span>
                        <h2>Recent Activity</h2>
                    </div>

                    <button type="button"
                            id="latestButton">

                        Latest Tasks →

                    </button>

                </div>


                <div class="activity-list">

                    @if (Model.RecentTasks.Any())
                    {
                        foreach (var task in Model.RecentTasks)
                        {
                            <button type="button"
                                    class="activity-item"
                                    data-id="@task.Id"
                                    data-title="@task.Title">

                                <span class="activity-icon">
                                    ✓
                                </span>

                                <span>

                                    <strong>
                                        @task.Title
                                    </strong>

                                    <small>
                                        @task.Status
                                        
                                        
                                    </small>

                                </span>

                                <time>
                                    @task.ExpectedEndDate.ToString("dd MMM")
                                </time>

                            </button>
                        }
                    }
                    else
                    {
                        <div class="empty">

                            <span>◌</span>

                            <strong>
                                No recent activity
                            </strong>

                        </div>
                    }

                </div>

            </article>

        </section>




        <!-- ================= GOAL ================= -->

        <section class="goal">

            <div class="goal-image"></div>

            <div class="goal-content">

                <span>
                    Stay focused. Keep learning.
                </span>

                <h2>
                    Turn Your
                    <b>Goals</b>
                    Into
                    <em>Achievements</em>
                </h2>

                <p>
                    Build your progress one task at a time.
                </p>

            </div>


            <div class="goal-road">

                <span>Learn</span>
                <i></i>
                <span>Build</span>
                <i></i>
                <span>Improve</span>
                <i></i>
                <strong>Achieve ✦</strong>

            </div>

        </section>

    </main>

</div>

   @await Html.PartialAsync(
    "~/Areas/User/Views/Shared/_UserModals.cshtml")

<!-- ================= DASHBOARD TASK SUMMARY MODAL ================= -->
<div class="dashboard-task-modal"
     id="dashboardTaskModal"
     aria-hidden="true">
    <div class="dashboard-task-modal-box"
         role="dialog"
         aria-modal="true"
         aria-labelledby="dashboardTaskModalTitle">

        <button type="button"
                class="dashboard-task-modal-close"
                id="dashboardTaskModalClose"
                aria-label="Close">
            ×
        </button>

        <span class="dashboard-task-modal-eyebrow">TASK SUMMARY</span>
        <h2 id="dashboardTaskModalTitle">Tasks</h2>
        <p id="dashboardTaskModalSubtitle">
            Tasks currently available on your dashboard.
        </p>

        <div class="dashboard-task-modal-list"
             id="dashboardTaskModalList"></div>
    </div>
</div>





<script src="~/js/users/user-dashboard.js" asp-append-version="true"></script>
<script src="~/js/global-messages.js" asp-append-version="true"></script>

</body>
</html>