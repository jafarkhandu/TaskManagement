@model List<TaskManagement.Application.DTOs.ProjectDto>

@{
    Layout = null;

    var adminName = User.Identity?.Name ?? "Administrator";

    var adminInitial = !string.IsNullOrWhiteSpace(adminName)
        ? adminName.Substring(0, 1).ToUpper()
        : "A";

    var totalProjects = Model?.Count ?? 0;

    var activeProjects = Model?.Count(x =>
        x.Status.Equals("Active", StringComparison.OrdinalIgnoreCase)) ?? 0;

    var inProgressProjects = Model?.Count(x =>
        x.Status.Equals("In Progress", StringComparison.OrdinalIgnoreCase)) ?? 0;

    var completedProjects = Model?.Count(x =>
        x.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase)) ?? 0;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Projects - TaskManager</title>

    <!-- Bootstrap already exists in your project -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Existing admin dashboard styling -->
    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />

    <!-- Projects page styling -->
    <link rel="stylesheet"
          href="~/css/admin-projects.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin-common.css"
          asp-append-version="true" />

</head>


<body class="admin-projects-page">


<div class="admin-layout">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->
        @await Html.PartialAsync(
            "~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="main-content">


        <!-- =================================================
             TOPBAR
        ================================================== -->

       @await Html.PartialAsync(
    "~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")

        <!-- =================================================
             PROJECT CONTENT
        ================================================== -->

        <section class="projects-container">


            <!-- =================================================
                 PAGE HEADER
            ================================================== -->

            <div class="projects-page-header">


                <div>

                    <div class="projects-breadcrumb">

                        <span>
                            Admin
                        </span>

                        <span>
                            /
                        </span>

                        <strong>
                            Projects
                        </strong>

                    </div>


                    <h1>
                        Projects
                    </h1>


                    <p>
                        Manage all projects, view details,
                        track progress and manage tasks.
                    </p>

                </div>


                <!-- ADD PROJECT -->

                <button type="button"
                        class="add-project-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#addProjectModal">

                    <span class="plus-icon">
                        +
                    </span>

                    Add Project

                </button>


            </div>



            <!-- =================================================
                 PROJECT STATISTICS
            ================================================== -->

            <div class="project-statistics">


                <!-- TOTAL -->

                <div class="project-stat-card">

                    <div class="project-stat-icon blue">
                        ▣
                    </div>

                    <div>

                        <span>
                            Total Projects
                        </span>

                        <strong id="totalProjects">
                            @totalProjects
                        </strong>

                    </div>

                </div>


                <!-- ACTIVE -->

                <div class="project-stat-card">

                    <div class="project-stat-icon green">
                        ✓
                    </div>

                    <div>

                        <span>
                            Active
                        </span>

                        <strong id="activeProjects">
                            @activeProjects
                        </strong>

                    </div>

                </div>


                <!-- IN PROGRESS -->

                <div class="project-stat-card">

                    <div class="project-stat-icon orange">
                        ◷
                    </div>

                    <div>

                        <span>
                            In Progress
                        </span>

                        <strong id="inProgressProjects">
                            @inProgressProjects
                        </strong>

                    </div>

                </div>


                <!-- COMPLETED -->

                <div class="project-stat-card">

                    <div class="project-stat-icon purple">
                        ✓
                    </div>

                    <div>

                        <span>
                            Completed
                        </span>

                        <strong id="completedProjects">
                            @completedProjects
                        </strong>

                    </div>

                </div>


            </div>



            <!-- =================================================
                 SEARCH + FILTER
            ================================================== -->

            <div class="project-filter-bar">


                <div class="project-search">

                    <span>
                        ⌕
                    </span>

                    <input type="text"
                           id="projectSearch"
                           placeholder="Search projects by title, description or tech stack..." />

                </div>


                <select id="statusFilter"
                        class="status-filter">

                    <option value="">
                        All Status
                    </option>

                    <option value="Planning">
                        Planning
                    </option>

                    <option value="Active">
                        Active
                    </option>

                    <option value="In Progress">
                        In Progress
                    </option>

                    <option value="Completed">
                        Completed
                    </option>

                    <option value="On Hold">
                        On Hold
                    </option>

                </select>


                <button type="button"
                        id="resetFilters"
                        class="reset-filter-btn">

                    Reset

                </button>


            </div>



            <!-- =================================================
                 PROJECT LIST
            ================================================== -->

            <div id="projectsList">


                @if (Model != null && Model.Any())
                {


                    foreach (var project in Model)
                    {


                        var projectInitial =
                            !string.IsNullOrWhiteSpace(project.ProjectTitle)
                                ? project.ProjectTitle.Substring(0, 1).ToUpper()
                                : "P";


                        <article class="project-item"
                                 data-title="@project.ProjectTitle"
                                 data-description="@project.Description"
                                 data-tech="@project.TechStack"
                                 data-status="@project.Status"
                                 data-project-id="@project.Id">


                            <!-- LEFT -->

                            <div class="project-item-left">


                                <div class="project-logo">

                                    @projectInitial

                                </div>


                                <div class="project-details">


                                    <h2>
                                        @project.ProjectTitle
                                    </h2>


                                    <p class="project-description">

                                        @(
                                            string.IsNullOrWhiteSpace(project.Description)
                                                ? "No description provided for this project."
                                                : project.Description
                                        )

                                    </p>


                                    <!-- META -->

                                    <div class="project-meta">


                                        <div class="project-meta-item">

                                            <span class="meta-icon">
                                                📅
                                            </span>

                                            <span>

                                                <small>
                                                    Start Date
                                                </small>

                                                @project.StartDate.ToString("dd MMM yyyy")

                                            </span>

                                        </div>


                                        <div class="meta-line"></div>


                                        <div class="project-meta-item">

                                            <span class="meta-icon">
                                                📅
                                            </span>

                                            <span>

                                                <small>
                                                    End Date
                                                </small>

                                                @project.EndDate.ToString("dd MMM yyyy")

                                            </span>

                                        </div>


                                        <div class="meta-line"></div>


                                        <!-- Members count removed -->


                                    </div>


                                    <!-- TECH STACK -->

                                    @if (!string.IsNullOrWhiteSpace(project.TechStack))
                                    {

                                        <div class="tech-stack-list">


                                            @foreach (var tech in project.TechStack.Split(
                                                ',',
                                                StringSplitOptions.RemoveEmptyEntries))
                                            {

                                                <span class="tech-tag">
                                                    @tech.Trim()
                                                </span>

                                            }


                                        </div>

                                    }


                                </div>


                            </div>



                            <!-- RIGHT -->

                            <div class="project-item-right">


                                <!-- STATUS -->

                                <div class="project-status-wrapper">

                                    <span class="status-title">
                                        Status
                                    </span>

                                    <span class="project-status
                                        @GetStatusClass(project.Status)">

                                        @project.Status

                                    </span>

                                </div>


                                <!-- ACTIONS -->

                                <div class="project-actions">


                                    <!-- VIEW -->

                                    <button type="button"
                                            class="project-action-btn view-project-btn"
                                            data-project-id="@project.Id">

                                        <span>
                                            ◉
                                        </span>

                                        View Details

                                    </button>


                                    <!-- MANAGE TASKS -->

                                    <button type="button"
                                            class="project-action-btn manage-task-btn"
                                            data-project-id="@project.Id">

                                        <span>
                                            ☷
                                        </span>

                                        Manage Tasks

                                    </button>


                                    <!-- MORE -->

                                    <button type="button"
                                            class="project-more-btn"
                                            data-project-id="@project.Id">

                                        ⋮

                                    </button>


                                </div>


                            </div>


                        </article>


                    }


                }
                else
                {


                    <!-- EMPTY -->

                    <div class="empty-project-state"
                         id="emptyProjectState">


                        <div class="empty-project-icon">
                            ▣
                        </div>


                        <h3>
                            No projects yet
                        </h3>


                        <p>
                            Create your first project to get started.
                        </p>


                        <button type="button"
                                class="add-project-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#addProjectModal">

                            <span class="plus-icon">
                                +
                            </span>

                            Add Project

                        </button>


                    </div>


                }


            </div>


        </section>


    </main>


</div>



<!-- =========================================================
     ADD PROJECT MODAL
========================================================= -->

<div class="modal fade"
     id="addProjectModal"
     tabindex="-1"
     aria-labelledby="addProjectModalLabel"
     aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered modal-lg">


        <div class="modal-content project-modal">


            <!-- MODAL HEADER -->

            <div class="modal-header project-modal-header">


                <div class="modal-title-wrapper">


                    <div class="modal-project-icon">
                        ▣
                    </div>


                    <div>

                        <h2 id="addProjectModalLabel">
                            Add New Project
                        </h2>

                        <p>
                            Enter the details for your new project.
                        </p>

                    </div>


                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>


            </div>



            <!-- FORM -->

            <form id="createProjectForm"
                  method="post"
                  action="@Url.Action(
                      "Create",
                      "Projects",
                      new { area = "Admin" })">


                @Html.AntiForgeryToken()


                <!-- BODY -->

                <div class="modal-body project-modal-body">


                    <!-- PROJECT TITLE -->

                    <div class="form-field">


                        <label for="ProjectTitle">

                            Project Title

                            <span>*</span>

                        </label>


                        <input type="text"
                               id="ProjectTitle"
                               name="ProjectTitle"
                               class="project-input"
                               maxlength="150"
                               placeholder="Enter project title"
                               required />


                    </div>



                    <!-- DESCRIPTION -->

                    <div class="form-field">


                        <label for="Description">
                            Description
                        </label>


                        <textarea id="Description"
                                  name="Description"
                                  class="project-input project-textarea"
                                  maxlength="2000"
                                  rows="4"
                                  placeholder="Describe what this project is about..."></textarea>


                    </div>



                    <!-- TECH STACK -->

                    <div class="form-field">


                        <label for="TechStack">
                            Tech Stack
                        </label>


                        <input type="text"
                               id="TechStack"
                               name="TechStack"
                               class="project-input"
                               maxlength="500"
                               placeholder="e.g. ASP.NET Core, SQL Server, Bootstrap" />


                        <small>
                            Separate technologies using commas.
                        </small>


                    </div>



                    <!-- DATES -->

                    <div class="project-form-row">


                        <div class="form-field">


                            <label for="StartDate">

                                Start Date

                                <span>*</span>

                            </label>


                            <input type="date"
                                   id="StartDate"
                                   name="StartDate"
                                   class="project-input"
                                   required />


                        </div>


                        <div class="form-field">


                            <label for="EndDate">

                                End Date

                                <span>*</span>

                            </label>


                            <input type="date"
                                   id="EndDate"
                                   name="EndDate"
                                   class="project-input"
                                   required />


                        </div>


                    </div>



                    <!-- STATUS + MEMBERS -->

                    <div class="project-form-row">


                        <div class="form-field">


                            <label for="Status">

                                Status

                                <span>*</span>

                            </label>


                            <select id="Status"
                                    name="Status"
                                    class="project-input"
                                    required>


                                <option value="Planning">
                                    Planning
                                </option>


                                <option value="Active">
                                    Active
                                </option>


                                <option value="In Progress">
                                    In Progress
                                </option>


                                <option value="Completed">
                                    Completed
                                </option>


                                <option value="On Hold">
                                    On Hold
                                </option>


                            </select>


                        </div>



                        <!-- Members count field removed from Create Project modal -->


                    </div>



                    <!-- ERROR -->

                    <div id="projectFormError"
                         class="project-form-message error"
                         style="display:none;">
                    </div>

                    <!-- FOOTER -->

                    <div class="modal-footer project-modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">Cancel</button>

                        <button type="submit"
                                class="btn btn-primary">
                            Create Project
                        </button>

                    </div>

                </div> <!-- /.modal-body -->

            </form>

        </div> <!-- /.modal-content -->

    </div> <!-- /.modal-dialog -->

</div> <!-- /#addProjectModal -->

<!-- EDIT PROJECT MODAL -->
<div class="modal fade"
     id="editProjectModal"
     tabindex="-1"
     aria-labelledby="editProjectModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content project-modal">

            <!-- MODAL HEADER -->
            <div class="modal-header project-modal-header">

                <div class="modal-title-wrapper">

                    <div class="modal-project-icon">
                        ▣
                    </div>

                    <div>

                        <h2 id="editProjectModalLabel">
                            Edit Project
                        </h2>

                        <p>
                            Update the details for this project.
                        </p>

                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form id="editProjectForm"
                  method="post"
                  action="@Url.Action(
                      "Update",
                      "Projects",
                      new { area = "Admin" })">

                @Html.AntiForgeryToken()

                <input type="hidden" id="EditId" name="Id" />

                <div class="modal-body project-modal-body">

                    <div class="form-field">

                        <label for="EditProjectTitle">

                            Project Title

                            <span>*</span>

                        </label>


                        <input type="text"
                               id="EditProjectTitle"
                               name="ProjectTitle"
                               class="project-input"
                               maxlength="150"
                               placeholder="Enter project title"
                               required />


                    </div>

                    <div class="form-field">

                        <label for="EditDescription">
                            Description
                        </label>


                        <textarea id="EditDescription"
                                  name="Description"
                                  class="project-input project-textarea"
                                  maxlength="2000"
                                  rows="4"
                                  placeholder="Describe what this project is about..."></textarea>


                    </div>

                    <div class="form-field">

                        <label for="EditTechStack">
                            Tech Stack
                        </label>


                        <input type="text"
                               id="EditTechStack"
                               name="TechStack"
                               class="project-input"
                               maxlength="500"
                               placeholder="e.g. ASP.NET Core, SQL Server, Bootstrap" />

                        <small>
                            Separate technologies using commas.
                        </small>


                    </div>

                    <div class="project-form-row">

                        <div class="form-field">

                            <label for="EditStartDate">

                                Start Date

                                <span>*</span>

                            </label>


                            <input type="date"
                                   id="EditStartDate"
                                   name="StartDate"
                                   class="project-input"
                                   required />


                        </div>


                        <div class="form-field">

                            <label for="EditEndDate">

                                End Date

                                <span>*</span>

                            </label>


                            <input type="date"
                                   id="EditEndDate"
                                   name="EndDate"
                                   class="project-input"
                                   required />


                        </div>


                    </div>

                    <div class="project-form-row">

                        <div class="form-field">

                            <label for="EditStatus">

                                Status

                                <span>*</span>

                            </label>


                            <select id="EditStatus"
                                    name="Status"
                                    class="project-input"
                                    required>

                                <option value="Planning">Planning</option>
                                <option value="Active">Active</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="On Hold">On Hold</option>

                            </select>


                        </div>


                        <!-- Members count field removed from Edit Project modal -->


                    </div>

                    <div id="editProjectFormError"
                         class="project-form-message error"
                         style="display:none;">
                    </div>

                    <div class="modal-footer project-modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">Cancel</button>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@functions {
    // Return a CSS class name for a given project status
    private string GetStatusClass(string status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "status-planning";

        return status.Trim().ToLower() switch
        {
            "active" => "status-active",
            "in progress" => "status-inprogress",
            "completed" => "status-completed",
            "on hold" => "status-onhold",
            _ => "status-planning",
        };
    }
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/admin-projects.js" asp-append-version="true"></script>
<script src="~/js/admin-common.js"
        asp-append-version="true"></script>
</body>

</html>
