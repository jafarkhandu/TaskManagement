@using TaskManagement.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@model List<ApplicationUser>

@{
    ViewData["Title"] = "Users";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>TaskManager - Users</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-users.css"
          asp-append-version="true" />

</head>

<body class="admin-dashboard">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="sidebar-brand">

            <div class="brand-logo">
                ✓
            </div>

            <div class="brand-text">

                <strong>TaskManager</strong>

                <span>
                    Plan · Assign · Track
                </span>

            </div>

        </div>


        <nav class="sidebar-nav">

            <a href="@Url.Action(
                "Index",
                "Dashboard",
                new { area = "Admin" })"
               class="sidebar-link">

                <span class="nav-icon">⌂</span>

                <span>Dashboard</span>

            </a>


            <a href="@Url.Action(
                "Index",
                "Projects",
                new { area = "Admin" })"
               class="sidebar-link">

                <span class="nav-icon">▣</span>

                <span>Projects</span>

            </a>


            <a href="@Url.Action(
                "Index",
                "Users",
                new { area = "Admin" })"
               class="sidebar-link active">

                <span class="nav-icon">♙</span>

                <span>Users</span>

            </a>


            <a href="#"
               class="sidebar-link">

                <span class="nav-icon">▣</span>

                <span>Calendar</span>

            </a>


            <a href="#"
               class="sidebar-link">

                <span class="nav-icon">▥</span>

                <span>Reports</span>

            </a>


            <a href="#"
               class="sidebar-link">

                <span class="nav-icon">⚙</span>

                <span>Settings</span>

            </a>

        </nav>


        <div class="admin-card">

            <div class="admin-card-icon">
                ♛
            </div>

            <div class="admin-card-content">

                <strong>
                    Admin Panel
                </strong>

                <span>
                    Manage projects, users
                    and tasks in one place.
                </span>

            </div>

            <span class="admin-arrow">
                →
            </span>

        </div>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main-content">


        <!-- TOPBAR -->

        <header class="topbar">

            <div class="search-box">

                <span class="search-icon">
                    ⌕
                </span>

                <input type="text"
                       id="userSearch"
                       placeholder="Search users..." />

                <span class="search-shortcut">
                    Ctrl K
                </span>

            </div>

        </header>


        <div class="dashboard-container">


            @Html.AntiForgeryToken()


            <!-- ================= PAGE HEADER ================= -->

            <section class="welcome-section">

                <div>

                    <div class="welcome-small">
                        Administration
                    </div>

                    <h1>
                        Users
                    </h1>

                    <p>
                        Manage users and their accounts.
                    </p>

                </div>

            </section>


            <!-- ================= USERS CARD ================= -->

            <section class="dashboard-card users-card">


                <div class="card-header">

                    <div class="card-title">

                        <span class="title-icon">
                            ♙
                        </span>

                        <h2>
                            User Management
                        </h2>

                    </div>


                    <span class="user-count">

                        <strong id="visibleUserCount">
                            @Model.Count
                        </strong>

                        Users

                    </span>

                </div>


                <!-- SEARCH / FILTER AREA -->

                <div class="users-toolbar">

                    <div class="users-filter-info">

                        <span>
                            All registered accounts
                        </span>

                    </div>

                    <button type="button"
                            class="clear-search-btn"
                            id="clearSearchBtn"
                            style="display:none;">

                        Clear Search

                    </button>

                </div>


                <!-- ================= TABLE ================= -->

                <div class="table-responsive">


                    <table class="project-table users-table">


                        <thead>

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody id="usersTableBody">


                            @if (Model.Any())
                            {

                                foreach (var user in Model)
                                {

                                    var roles =
                                        await UserManager.GetRolesAsync(user);

                                    var role =
                                        roles.FirstOrDefault() ?? "User";


                                    <tr class="user-row"
                                        data-search="@($"{user.FullName} {user.Email} {user.PhoneNumber} {role}")">


                                        <!-- USER -->

                                        <td>

                                            <div class="user-info-cell">


                                                <div class="user-avatar">

                                                    @{
                                                        var displayName =
                                                            string.IsNullOrWhiteSpace(user.FullName)
                                                                ? user.Email ?? "U"
                                                                : user.FullName;

                                                        var initials =
                                                            string.Join(
                                                                "",
                                                                displayName
                                                                    .Split(
                                                                        ' ',
                                                                        StringSplitOptions.RemoveEmptyEntries)
                                                                    .Take(2)
                                                                    .Select(x => x[0])
                                                            ).ToUpper();
                                                    }

                                                    @initials

                                                </div>


                                                <div class="user-name-block">

                                                    <strong>

                                                        @(string.IsNullOrWhiteSpace(user.FullName)
                                                            ? "Unnamed User"
                                                            : user.FullName)

                                                    </strong>

                                                    <span>
                                                        @user.UserName
                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- EMAIL -->

                                        <td>

                                            <span class="user-email">

                                                @(string.IsNullOrWhiteSpace(user.Email)
                                                    ? "-"
                                                    : user.Email)

                                            </span>

                                        </td>


                                        <!-- PHONE -->

                                        <td>

                                            @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                                ? "-"
                                                : user.PhoneNumber)

                                        </td>


                                        <!-- ROLE -->

                                        <td>

                                            @if (string.Equals(
                                                role,
                                                "Admin",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="role-badge role-admin">
                                                    Admin
                                                </span>
                                            }
                                            else if (string.Equals(
                                                role,
                                                "Manager",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="role-badge role-manager">
                                                    Manager
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="role-badge role-user">
                                                    User
                                                </span>
                                            }

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            @if (user.IsActive)
                                            {
                                                <span class="status status-completed">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status status-pending">
                                                    Inactive
                                                </span>
                                            }

                                        </td>


                                        <!-- ACTIONS -->

                                        <td>

                                            <div class="user-actions">


                                                <a href="@Url.Action(
                                                    "Manage",
                                                    "Users",
                                                    new
                                                    {
                                                        area = "Admin",
                                                        id = user.Id
                                                    })"
                                                   class="user-action-btn manage-btn">

                                                    Manage

                                                </a>


                                                @if (user.IsActive)
                                                {

                                                    @if (!string.Equals(
                                                        role,
                                                        "Admin",
                                                        StringComparison.OrdinalIgnoreCase))
                                                    {

                                                        <button type="button"
                                                                class="user-action-btn deactivate-btn deactivate-account-btn"
                                                                data-user-id="@user.Id">

                                                            Deactivate

                                                        </button>

                                                    }

                                                }
                                                else
                                                {

                                                    <button type="button"
                                                            class="user-action-btn activate-btn activate-account-btn"
                                                            data-user-id="@user.Id">

                                                        Activate

                                                    </button>

                                                }


                                            </div>

                                        </td>

                                    </tr>

                                }

                            }
                            else
                            {

                                <tr>

                                    <td colspan="6">

                                        <div class="empty-users">

                                            <div class="empty-users-icon">
                                                ♙
                                            </div>

                                            <h3>
                                                No Users Found
                                            </h3>

                                            <p>
                                                There are currently no registered users.
                                            </p>

                                        </div>

                                    </td>

                                </tr>

                            }


                        </tbody>

                    </table>

                </div>


                <!-- NO SEARCH RESULT -->

                <div id="noSearchResults"
                     class="empty-users search-empty"
                     style="display:none;">

                    <div class="empty-users-icon">
                        ⌕
                    </div>

                    <h3>
                        No Matching Users
                    </h3>

                    <p>
                        Try searching with another name, email or role.
                    </p>

                </div>


            </section>


        </div>

    </main>


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/admin-users.js"
            asp-append-version="true"></script>

</body>

</html>