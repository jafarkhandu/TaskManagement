@using TaskManagement.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@model List<ApplicationUser>

@{
    ViewData["Title"] = "Users";
    Layout = null;

    var userRoles =
        ViewData["UserRoles"] as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    string GetUserRole(ApplicationUser user)
    {
        return userRoles.TryGetValue(user.Id, out var role)
            ? role
            : "User";
    }

    var totalUsers = Model.Count;
    var activeUsers = Model.Where(u => u.IsActive).ToList();
    var inactiveUsers = Model.Where(u => !u.IsActive).ToList();

    var specialAdmins = Model
        .Where(u => string.Equals(
            GetUserRole(u),
            "Admin",
            StringComparison.OrdinalIgnoreCase))
        .ToList();

    var managers = Model
        .Where(u => string.Equals(
            GetUserRole(u),
            "Manager",
            StringComparison.OrdinalIgnoreCase))
        .ToList();

    var administratorCount = specialAdmins.Count + managers.Count;

    string GetDisplayName(ApplicationUser user)
    {
        return string.IsNullOrWhiteSpace(user.FullName)
            ? (user.Email ?? "Unnamed User")
            : user.FullName;
    }

    string GetInitials(ApplicationUser user)
    {
        var displayName = GetDisplayName(user);

        return string.Join(
            "",
            displayName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(x => x[0]))
            .ToUpper();
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/ciit-logo.png" asp-append-version="true" />

    <title>TaskManager - Users</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/admin-users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/admin/admin-common.css"
      asp-append-version="true" />

</head>

<body class="admin-dashboard">

    <!-- ================= SIDEBAR ================= -->

    @await Html.PartialAsync(
    "~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")


    <!-- ================= MAIN ================= -->

    <main class="main-content">


        @await Html.PartialAsync(
    "~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")

        <div class="dashboard-container">


            @Html.AntiForgeryToken()


            <!-- ================= PAGE HEADER ================= -->

            <section class="welcome-section">

                <div>

                    <div class="welcome-small">
                        Administration
                    </div>

                    <h1>
                        Users
                    </h1>

                    <p>
                        Manage users and their accounts.
                    </p>

                </div>

            </section>


            <!-- ================= USER SUMMARY CARDS ================= -->

            <section class="user-summary-grid"
                     aria-label="User statistics">

                <button type="button"
                        class="user-summary-card user-summary-card-total"
                        data-user-summary="total">

                    <span class="user-summary-icon" aria-hidden="true">👥</span>

                    <span class="user-summary-content">
                        <span class="user-summary-label">Total Users</span>
                        <strong>@totalUsers</strong>
                    </span>

                </button>

                <button type="button"
                        class="user-summary-card user-summary-card-active"
                        data-user-summary="active">

                    <span class="user-summary-icon" aria-hidden="true">●</span>

                    <span class="user-summary-content">
                        <span class="user-summary-label">Active Users</span>
                        <strong>@activeUsers.Count</strong>
                    </span>

                </button>

                <button type="button"
                        class="user-summary-card user-summary-card-inactive"
                        data-user-summary="inactive">

                    <span class="user-summary-icon" aria-hidden="true">●</span>

                    <span class="user-summary-content">
                        <span class="user-summary-label">Inactive Users</span>
                        <strong>@inactiveUsers.Count</strong>
                    </span>

                </button>

                <button type="button"
                        class="user-summary-card user-summary-card-admin"
                        data-user-summary="administrators">

                    <span class="user-summary-icon" aria-hidden="true">♜</span>

                    <span class="user-summary-content">
                        <span class="user-summary-label">Administrators</span>
                        <strong>@administratorCount</strong>
                    </span>

                </button>

            </section>


            <!-- ================= USER SUMMARY MODAL ================= -->

            <div class="user-summary-modal"
                 id="userSummaryModal"
                 hidden
                 aria-hidden="true">

                <div class="user-summary-modal-backdrop"
                     data-user-summary-close></div>

                <section class="user-summary-dialog"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="userSummaryModalTitle">

                    <div class="user-summary-dialog-header">

                        <div>
                            <span class="user-summary-dialog-eyebrow">
                                User Management
                            </span>

                            <h2 id="userSummaryModalTitle">Users</h2>
                        </div>

                        <button type="button"
                                class="user-summary-modal-close"
                                data-user-summary-close
                                aria-label="Close user list">
                            ×
                        </button>

                    </div>

                    <div class="user-summary-dialog-body"
                         id="userSummaryDialogBody">
                    </div>

                </section>

            </div>


            <!-- ================= USERS CARD ================= -->

            <section class="dashboard-card users-card">


                <div class="card-header">

                    <div class="card-title">

                        <span class="title-icon">
                            ♙
                        </span>

                        <h2>
                            User Management
                        </h2>

                    </div>


                    <span class="user-count">

                        <strong id="visibleUserCount">
                            @Model.Count
                        </strong>

                        Users

                    </span>

                </div>


                <!-- SEARCH / FILTER AREA -->

                <div class="users-toolbar">

                    <div class="users-filter-info">

                        <span>
                            All registered accounts
                        </span>

                    </div>

                    <button type="button"
                            class="clear-search-btn"
                            id="clearSearchBtn"
                            style="display:none;">

                        Clear Search

                    </button>

                </div>


                <!-- ================= TABLE ================= -->

                <div class="table-responsive">


                    <table class="project-table users-table">


                        <thead>

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody id="usersTableBody">


                            @if (Model.Any())
                            {

                                foreach (var user in Model)
                                {

                                    var role = GetUserRole(user);


                                    <tr class="user-row"
                                        data-user-id="@user.Id"
                                        data-user-name="@GetDisplayName(user)"
                                        data-user-email="@(user.Email ?? "")"
                                        data-user-role="@role"
                                        data-user-active="@user.IsActive.ToString().ToLowerInvariant()"
                                        data-user-photo="@(user.ProfilePictureUrl ?? "")"
                                        data-search="@($"{user.FullName} {user.Email} {user.PhoneNumber} {role}")">


                                        <!-- USER -->

                                        <td>

                                            <div class="user-info-cell">


                                                <div class="user-avatar @(string.IsNullOrWhiteSpace(user.ProfilePictureUrl) ? "" : "has-photo")">

                                                    @if (!string.IsNullOrWhiteSpace(user.ProfilePictureUrl))
                                                    {
                                                        <img src="@user.ProfilePictureUrl" alt="@user.FullName" />
                                                    }
                                                    else
                                                    {
                                                        var displayName =
                                                            string.IsNullOrWhiteSpace(user.FullName)
                                                                ? user.Email ?? "U"
                                                                : user.FullName;

                                                        var initials =
                                                            string.Join(
                                                                "",
                                                                displayName
                                                                    .Split(
                                                                        ' ',
                                                                        StringSplitOptions.RemoveEmptyEntries)
                                                                    .Take(2)
                                                                    .Select(x => x[0])
                                                            ).ToUpper();

                                                        <text>@initials</text>
                                                    }
                                                </div>


                                                <div class="user-name-block">

                                                    <strong>

                                                        @(string.IsNullOrWhiteSpace(user.FullName)
                                                            ? "Unnamed User"
                                                            : user.FullName)

                                                    </strong>

                                                    <span>
                                                        @user.UserName
                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- EMAIL -->

                                        <td>

                                            <span class="user-email">

                                                @(string.IsNullOrWhiteSpace(user.Email)
                                                    ? "-"
                                                    : user.Email)

                                            </span>

                                        </td>


                                        <!-- PHONE -->

                                        <td>

                                            @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                                ? "-"
                                                : user.PhoneNumber)

                                        </td>


                                        <!-- ROLE -->

                                        <td>

                                            @if (string.Equals(
                                                role,
                                                "Admin",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="role-badge role-admin">
                                                    Admin
                                                </span>
                                            }
                                            else if (string.Equals(
                                                role,
                                                "Manager",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="role-badge role-manager">
                                                    Manager
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="role-badge role-user">
                                                    User
                                                </span>
                                            }

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            @if (user.IsActive)
                                            {
                                                <span class="status status-completed">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status status-pending">
                                                    Inactive
                                                </span>
                                            }

                                        </td>


                                        <!-- ACTIONS -->

                                        <td>

                                            <div class="user-actions">

                                                <div class="user-action-menu">

                                                    <button type="button"
                                                            class="user-action-menu-trigger"
                                                            aria-label="Open actions for @(string.IsNullOrWhiteSpace(user.FullName) ? "user" : user.FullName)"
                                                            aria-expanded="false">

                                                        <span aria-hidden="true">⋮</span>

                                                    </button>

                                                    <div class="user-action-menu-panel" role="menu">

                                                        <a href="@Url.Action(
                                                            "Manage",
                                                            "Users",
                                                            new
                                                            {
                                                                area = "Admin",
                                                                id = user.Id
                                                            })"
                                                           class="user-action-menu-item"
                                                           role="menuitem">

                                                            Manage User

                                                        </a>

                                                        @if (user.IsActive)
                                                        {
                                                            @if (!string.Equals(
                                                                role,
                                                                "Admin",
                                                                StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <button type="button"
                                                                        class="user-action-menu-item user-action-menu-danger deactivate-account-btn"
                                                                        data-user-id="@user.Id"
                                                                        role="menuitem">

                                                                    Deactivate User

                                                                </button>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="user-action-menu-item user-action-menu-success activate-account-btn"
                                                                    data-user-id="@user.Id"
                                                                    role="menuitem">

                                                                Activate User

                                                            </button>
                                                        }

                                                    </div>

                                                </div>

                                            </div>

                                        </td>

                                    </tr>

                                }

                            }
                            else
                            {

                                <tr>

                                    <td colspan="6">

                                        <div class="empty-users">

                                            <div class="empty-users-icon">
                                                ♙
                                            </div>

                                            <h3>
                                                No Users Found
                                            </h3>

                                            <p>
                                                There are currently no registered users.
                                            </p>

                                        </div>

                                    </td>

                                </tr>

                            }


                        </tbody>

                    </table>

                </div>


                <!-- NO SEARCH RESULT -->

                <div id="noSearchResults"
                     class="empty-users search-empty"
                     style="display:none;">

                    <div class="empty-users-icon">
                        ⌕
                    </div>

                    <h3>
                        No Matching Users
                    </h3>

                    <p>
                        Try searching with another name, email or role.
                    </p>

                </div>


            </section>


        </div>

    </main>


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/admin/admin-users.js"
            asp-append-version="true"></script>
    <script src="~/js/admin/admin-common.js"
        asp-append-version="true"></script>
</body>

</html>