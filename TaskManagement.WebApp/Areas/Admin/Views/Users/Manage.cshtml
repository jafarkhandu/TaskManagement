@using TaskManagement.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> _userManager
@model ApplicationUser

@{
    ViewData["Title"] = "Manage User";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>TaskManager - Manage User</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />

</head>

<body class="admin-dashboard">

    <aside class="sidebar">

        <div class="sidebar-brand">

            <div class="brand-logo">
                ✓
            </div>

            <div class="brand-text">

                <strong>TaskManager</strong>

                <span>
                    Plan · Assign · Track
                </span>

            </div>

        </div>


        <nav class="sidebar-nav">

            <a href="@Url.Action(
                       "Index",
                       "Dashboard",
                       new { area = "Admin" })"
               class="sidebar-link">

                <span class="nav-icon">⌂</span>

                <span>Dashboard</span>

            </a>


            <a href="@Url.Action(
                       "Index",
                       "Projects",
                       new { area = "Admin" })"
               class="sidebar-link">

                <span class="nav-icon">▣</span>

                <span>Projects</span>

            </a>


            <a href="@Url.Action(
                       "Index",
                       "Users",
                       new { area = "Admin" })"
               class="sidebar-link active">

                <span class="nav-icon">♙</span>

                <span>Users</span>

            </a>


            <!-- Manage Roles removed - role management merged into Users -->


            <a href="#"
               class="sidebar-link">

                <span class="nav-icon">▣</span>

                <span>Calendar</span>

            </a>


            <a href="#"
               class="sidebar-link">

                <span class="nav-icon">▥</span>

                <span>Reports</span>

            </a>


            <a href="#"
               class="sidebar-link">

                <span class="nav-icon">⚙</span>

                <span>Settings</span>

            </a>

        </nav>


        <div class="admin-card">

            <div class="admin-card-icon">
                ♛
            </div>

            <div class="admin-card-content">

                <strong>
                    Admin Panel
                </strong>

                <span>
                    Manage projects, users
                    and tasks in one place.
                </span>

            </div>

            <span class="admin-arrow">
                →
            </span>

        </div>

    </aside>


    <main class="main-content">

        <header class="topbar">

            <div class="search-box">

                <span class="search-icon">
                    ⌕
                </span>

                <input type="text"
                       placeholder="Search users..." />

                <span class="search-shortcut">
                    Ctrl K
                </span>

            </div>

        </header>


        <div class="dashboard-container">

            <section class="welcome-section">

                <div>

                    <div class="welcome-small">
                        Administration
                    </div>

                    <h1>
                        Manage User
                    </h1>

                    <p>
                        View and manage user account details.
                    </p>

                </div>

            </section>


            <section class="dashboard-card projects-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-icon">
                            ♙
                        </span>

                        <h2>
                            User Details
                        </h2>

                    </div>

                </div>


                <div class="p-4">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <form action="@Url.Action(
                                              "Update",
                                              "Users",
                                              new { area = "Admin" })"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       name="fullName"
                                       class="form-control"
                                       value="@Model.FullName"
                                       required />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Email
                                </label>

                                <input type="email"
                                       name="email"
                                       class="form-control"
                                       value="@Model.Email"
                                       required />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Phone Number
                                </label>

                                <input type="tel"
                                       name="phoneNumber"
                                       class="form-control"
                                       value="@Model.PhoneNumber" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Username
                                </label>

                                <div class="form-control">
                                    @Model.UserName
                                </div>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Role
                                </label>

                                @{ 
                                    var roles = _userManager.GetRolesAsync(Model).Result;
                                    var currentRole = roles.FirstOrDefault() ?? "User";
                                    var isAdminUser = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
                                }

                                <select name="role"
                                        class="form-select"
                                        @(isAdminUser ? "disabled" : "")>

                                    @if (isAdminUser)
                                    {
                                        <option selected>Admin</option>
                                    }
                                    else
                                    {
                                        <option value="User" @(currentRole == "User" ? "selected" : "")>User</option>
                                        <option value="Manager" @(currentRole == "Manager" ? "selected" : "")>Manager</option>
                                    }

                                </select>

                            </div>

                        </div>


                        <div class="mt-4 d-flex gap-2">

                            <a href="@Url.Action(
                                                      "Index",
                                                      "Users",
                                                      new { area = "Admin" })"
                               class="btn btn-outline-secondary">

                                Back to Users

                            </a>


                            <button type="submit"
                                    class="btn btn-primary">

                                Save Changes

                            </button>

                        </div>

                    </form>


                    @if (_userManager.GetUserId(User) != Model.Id)
                    {
                        <form id="deleteUserForm"
                              action="@Url.Action(
                                              "Delete",
                                              "Users",
                                              new { area = "Admin" })"
                              method="post"
                              class="mt-2">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-danger">

                                Delete User

                            </button>

                        </form>
                    }

                </div>

            </section>

        </div>

    </main>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document
            .getElementById("deleteUserForm")
            ?.addEventListener("submit", function (event) {

                const confirmed = confirm(
                    "Are you sure you want to delete this user?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

    </script>

</body>

</html>