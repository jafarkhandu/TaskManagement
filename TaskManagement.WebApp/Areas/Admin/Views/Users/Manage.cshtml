@using TaskManagement.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using TaskManagement.Domain.Entities
@inject UserManager<ApplicationUser> _userManager
@model ApplicationUser

@{
    ViewData["Title"] = "Manage User";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/ciit-logo.png" asp-append-version="true" />

    <title>TaskManager - Manage User</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin/admin-common.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin/admin-user-manage.css"
          asp-append-version="true" />

</head>

<body class="admin-dashboard">

    @await Html.PartialAsync(
    "~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")


    <main class="main-content">

        @await Html.PartialAsync(
    "~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")


        <div class="dashboard-container">

            <section class="welcome-section">

                <div>

                    <div class="welcome-small">
                        Administration
                    </div>

                    <h1>
                        Manage User
                    </h1>

                    <p>
                        View and manage user account details.
                    </p>

                </div>

            </section>


            <section class="dashboard-card projects-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-icon">
                            ♙
                        </span>

                        <h2>
                            User Details
                        </h2>

                    </div>

                </div>


                <div class="p-4">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <form action="@Url.Action(
                                              "Update",
                                              "Users",
                                              new { area = "Admin" })"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       name="fullName"
                                       class="form-control"
                                       value="@Model.FullName"
                                       required />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Email
                                </label>

                                <input type="email"
                                       name="email"
                                       class="form-control"
                                       value="@Model.Email"
                                       required />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Phone Number
                                </label>

                                <input type="tel"
                                       name="phoneNumber"
                                       class="form-control"
                                       value="@Model.PhoneNumber" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Username
                                </label>

                                <div class="form-control">
                                    @Model.UserName
                                </div>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Role
                                </label>

                                @{ 
                                    var roles = _userManager.GetRolesAsync(Model).Result;
                                    var currentRole = roles.FirstOrDefault() ?? "User";
                                    var isAdminUser = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
                                }

                                <select name="role"
                                        class="form-select"
                                        @(isAdminUser ? "disabled" : "")>

                                    @if (isAdminUser)
                                    {
                                        <option selected>Admin</option>
                                    }
                                    else
                                    {
                                        <option value="User" @(currentRole == "User" ? "selected" : "")>User</option>
                                        <option value="Manager" @(currentRole == "Manager" ? "selected" : "")>Manager</option>
                                    }

                                </select>

                            </div>

                        </div>


                        <div class="mt-4 d-flex gap-2">

                            <a href="@Url.Action(
                                                      "Index",
                                                      "Users",
                                                      new { area = "Admin" })"
                               class="btn btn-outline-secondary">

                                Back to Users

                            </a>


                            <button type="submit"
                                    class="btn btn-primary">

                                Save Changes

                            </button>

                        </div>

                    </form>


                    @{
                        var paymentDetails = ViewBag.PaymentDetails as UserPaymentDetails;
                    }

                    <section class="admin-payment-panel">

                        <div class="admin-payment-header">
                            <div>
                                <div class="admin-payment-eyebrow">PAYMENT PROFILE</div>
                                <h3>Payment Details</h3>
                                <p>Validated payment information submitted by this user.</p>
                            </div>

                            <span class="admin-payment-badge @(paymentDetails == null ? "empty" : "saved")">
                                <span class="admin-payment-badge-dot"></span>
                                @(paymentDetails == null ? "Not Added" : paymentDetails.PaymentMethod + " • Format Validated")
                            </span>
                        </div>

                        @if (paymentDetails == null)
                        {
                            <div class="admin-payment-empty">
                                <span>＋</span>
                                This user has not added payment details yet.
                            </div>
                        }
                        else if (paymentDetails.PaymentMethod == "UPI")
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="admin-payment-field">
                                        <span>Payment Method</span>
                                        <strong>UPI</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="admin-payment-field">
                                        <span>UPI ID</span>
                                        <strong class="admin-payment-value">@paymentDetails.UpiId</strong>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="admin-payment-field">
                                        <span>Account Holder Name</span>
                                        <strong>@paymentDetails.AccountHolderName</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="admin-payment-field">
                                        <span>Bank Name</span>
                                        <strong>@paymentDetails.BankName</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="admin-payment-field">
                                        <span>Account Number</span>
                                        <strong class="admin-payment-value">@paymentDetails.AccountNumber</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="admin-payment-field">
                                        <span>IFSC Code</span>
                                        <strong class="admin-payment-value">@paymentDetails.IfscCode</strong>
                                    </div>
                                </div>
                            </div>
                        }

                    </section>


                    @if (_userManager.GetUserId(User) != Model.Id)
                    {
                        <form id="deleteUserForm"
                              action="@Url.Action(
                                              "Delete",
                                              "Users",
                                              new { area = "Admin" })"
                              method="post"
                              class="mt-2">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-danger">

                                Delete User

                            </button>

                        </form>
                    }

                </div>

            </section>

        </div>

    </main>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document
            .getElementById("deleteUserForm")
            ?.addEventListener("submit", function (event) {

                const confirmed = confirm(
                    "Are you sure you want to delete this user?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

    </script>
    <script src="~/js/admin/admin-common.js"
        asp-append-version="true"></script>

</body>

</html>