@model List<TaskManagement.Application.DTOs.TaskDto>

@{
    Layout = null;
    var projectId = ViewBag.ProjectId as int? ?? 0;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Project Tasks - TaskManager</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-tasks.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin-common.css"
          asp-append-version="true" />

</head>

<body>

    <div class="task-page">

        <!-- =====================================================
         SIDEBAR
    ====================================================== -->
        @await Html.PartialAsync(
            "~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")

        <!-- =====================================================
         MAIN
    ====================================================== -->

        <main class="task-main">

            <!-- TOPBAR -->

            @await Html.PartialAsync(
            "~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")

                <!-- =================================================
                 PROJECT HEADER
            ================================================== -->

                <div class="project-header-card">

                    <div class="project-main-info">

                        <div id="projectInitial"
                             class="project-avatar">

                            P

                        </div>

                        <div>

                            <div class="project-title-row">

                                <h2 id="projectTitle">
                                    Loading project...
                                </h2>

                                <span id="projectStatus"
                                      class="project-status">
                                    -
                                </span>

                            </div>

                            <p id="projectDescription">
                                Loading project details...
                            </p>


                            <div class="project-meta">

                                <div>

                                    <span class="meta-icon">
                                        ▣
                                    </span>

                                    <div>
                                        <small>Start Date</small>
                                        <strong id="projectStart">
                                            -
                                        </strong>
                                    </div>

                                </div>


                                <div>

                                    <span class="meta-icon">
                                        ▣
                                    </span>

                                    <div>
                                        <small>End Date</small>
                                        <strong id="projectEnd">
                                            -
                                        </strong>
                                    </div>

                                </div>


                                <div>

                                    <span class="meta-icon">
                                        &lt;/&gt;
                                    </span>

                                    <div>
                                        <small>Tech Stack</small>
                                        <strong id="projectTech">
                                            -
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="project-progress-box">

                        <div class="progress-heading">

                            <span>
                                Project Progress
                            </span>

                            <strong id="projectProgressPercent">
                                0%
                            </strong>

                        </div>

                        <div class="progress-track">

                            <div id="projectProgressBar"
                                 class="progress-value">
                            </div>

                        </div>

                    </div>


                    <div class="project-deadline">

                        <span class="deadline-icon">
                            ◷
                        </span>

                        <div>

                            <strong id="daysRemaining">
                                -
                            </strong>

                            <small>
                                Until project deadline
                            </small>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                 STATISTICS
            ================================================== -->

                <div class="task-stat-grid">

                    <div class="task-stat-card">

                        <button type="button"
                                id="allTasksTrigger"
                                class="stat-icon stat-icon-button"
                                title="View all tasks">

                            ☰

                        </button>

                        <div>
                            <span>Total Tasks</span>
                            <strong id="totalTasks">0</strong>
                            <small>All project tasks</small>
                        </div>

                    </div>


                    <div class="task-stat-card">

                        <div class="stat-icon gray">
                            ○
                        </div>

                        <div>
                            <span>Pending</span>
                            <strong id="pendingTasks">0</strong>
                            <small>Not started yet</small>
                        </div>

                    </div>


                    <div class="task-stat-card">

                        <div class="stat-icon blue">
                            ◯
                        </div>

                        <div>
                            <span>In Progress</span>
                            <strong id="progressTasks">0</strong>
                            <small>Currently working</small>
                        </div>

                    </div>


                    <div class="task-stat-card">

                        <div class="stat-icon purple">
                            ◉
                        </div>

                        <div>
                            <span>On Hold</span>
                            <strong id="holdTasks">0</strong>
                            <small>Currently paused</small>
                        </div>

                    </div>


                    <div class="task-stat-card">

                        <div class="stat-icon green">
                            ✓
                        </div>

                        <div>
                            <span>Completed</span>
                            <strong id="completedTasks">0</strong>
                            <small>Finished tasks</small>
                        </div>

                    </div>

                </div>


                <!-- =================================================
                 FILTER BAR
            ================================================== -->

                <div class="task-filter-card">

                    <div class="task-search-box">

                        <span>⌕</span>

                        <input id="taskSearch"
                               type="text"
                               placeholder="Search tasks by title or scenario..." />

                    </div>


                    <select id="taskStatusFilter">

                        <option value="">
                            All Status
                        </option>

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="In Progress">
                            In Progress
                        </option>

                        <option value="On Hold">
                            On Hold
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                        <option value="Cancelled">
                            Cancelled
                        </option>

                    </select>


                    <select id="taskPriorityFilter">

                        <option value="">
                            All Priority
                        </option>

                        <option value="Low">
                            Low
                        </option>

                        <option value="Medium">
                            Medium
                        </option>

                        <option value="High">
                            High
                        </option>

                        <option value="Critical">
                            Critical
                        </option>

                    </select>


                    <select id="taskAssigneeFilter">

                        <option value="">
                            All Assignees
                        </option>

                    </select>


                    <button type="button"
                            id="resetTaskFilters"
                            class="reset-task-btn">

                        Reset

                    </button>

                </div>


                <!-- =================================================
                 BOARD
            ================================================== -->

                <div id="taskBoard"
                     class="task-board">

                    <!-- columns generated from real Model data -->

                </div>


                <!-- =================================================
                 EMPTY STATE
            ================================================== -->

                <div id="taskEmptyState"
                     class="task-empty-state"
                     style="display:none;">

                    <div>
                        ✓
                    </div>

                    <h3>
                        No tasks found
                    </h3>

                    <p>
                        Try changing your filters or add a new task.
                    </p>

                </div>

            </section>

        </main>

    </div>


    <!-- =========================================================
     ADD TASK MODAL
========================================================= -->

    <div class="modal fade"
         id="addTaskModal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content">

                <div class="modal-header">

                    <div>

                        <small class="modal-eyebrow">
                            PROJECT TASK
                        </small>

                        <h5 class="modal-title">
                            Add Task
                        </h5>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <form id="addTaskForm"
                      method="post"
                      action="@Url.Action("Create", "Tasks", new { area = "Admin" })">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="ProjectId"
                           value="@projectId" />

                    <div class="modal-body task-form-body">

                        <div class="form-grid">

                            <div class="form-field full">

                                <label>Title</label>

                                <input name="Title"
                                       class="form-control"
                                       required />

                            </div>


                            <div class="form-field full">

                                <label>Scenario</label>

                                <textarea name="Scenario"
                                          class="form-control"
                                          rows="3"></textarea>

                            </div>


                            <div class="form-field">

                                <label>Assigned To</label>

                                <select name="AssignedToUserId"
                                        id="addAssignedTo"
                                        class="form-control"
                                        required>
                                </select>

                            </div>


                            <div class="form-field">

                                <label>Priority</label>

                                <select name="Priority"
                                        class="form-control">

                                    <option>Low</option>
                                    <option>Medium</option>
                                    <option>High</option>
                                    <option>Critical</option>

                                </select>

                            </div>


                            <div class="form-field">

                                <label>Status</label>

                                <select name="Status"
                                        class="form-control">

                                    <option>Pending</option>
                                    <option>In Progress</option>
                                    <option>On Hold</option>
                                    <option>Completed</option>
                                    <option>Cancelled</option>

                                </select>

                            </div>


                            <div class="form-field">

                                <label>Amount</label>

                                <input type="number"
                                       step="0.01"
                                       name="Amount"
                                       class="form-control"
                                       required />

                            </div>


                            <div class="form-field">

                                <label>Start Date</label>

                                <input type="date"
                                       name="StartDate"
                                       class="form-control"
                                       required />

                            </div>


                            <div class="form-field">

                                <label>Expected End Date</label>

                                <input type="date"
                                       name="ExpectedEndDate"
                                       class="form-control"
                                       required />

                            </div>

                        </div>

                        <div id="addTaskError"
                             class="task-form-error"
                             style="display:none;">
                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            Save Task

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- =========================================================
     EDIT TASK MODAL
========================================================= -->

    <div class="modal fade"
         id="editTaskModal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content">

                <div class="modal-header">

                    <div>

                        <small class="modal-eyebrow">
                            UPDATE TASK
                        </small>

                        <h5 class="modal-title">
                            Edit Task
                        </h5>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <form id="editTaskForm"
                      method="post"
                      action="@Url.Action("Update", "Tasks", new { area = "Admin" })">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="Id"
                           id="editTaskId" />

                    <input type="hidden"
                           name="ProjectId"
                           id="editProjectId"
                           value="@projectId" />


                    <div class="modal-body task-form-body">

                        <div class="form-grid">

                            <div class="form-field full">

                                <label>Title</label>

                                <input name="Title"
                                       id="editTitle"
                                       class="form-control"
                                       required />

                            </div>


                            <div class="form-field full">

                                <label>Scenario</label>

                                <textarea name="Scenario"
                                          id="editScenario"
                                          class="form-control"
                                          rows="3"></textarea>

                            </div>


                            <div class="form-field">

                                <label>Assigned To</label>

                                <select name="AssignedToUserId"
                                        id="editAssignedTo"
                                        class="form-control"
                                        required>
                                </select>

                            </div>


                            <div class="form-field">

                                <label>Priority</label>

                                <select name="Priority"
                                        id="editPriority"
                                        class="form-control">

                                    <option>Low</option>
                                    <option>Medium</option>
                                    <option>High</option>
                                    <option>Critical</option>

                                </select>

                            </div>


                            <div class="form-field">

                                <label>Status</label>

                                <select name="Status"
                                        id="editStatus"
                                        class="form-control">

                                    <option>Pending</option>
                                    <option>In Progress</option>
                                    <option>On Hold</option>
                                    <option>Completed</option>
                                    <option>Cancelled</option>

                                </select>

                            </div>


                            <div class="form-field">

                                <label>Amount</label>

                                <input type="number"
                                       step="0.01"
                                       name="Amount"
                                       id="editAmount"
                                       class="form-control"
                                       required />

                            </div>


                            <div class="form-field">

                                <label>Start Date</label>

                                <input type="date"
                                       name="StartDate"
                                       id="editStartDate"
                                       class="form-control"
                                       required />

                            </div>


                            <div class="form-field">

                                <label>Expected End Date</label>

                                <input type="date"
                                       name="ExpectedEndDate"
                                       id="editExpectedEndDate"
                                       class="form-control"
                                       required />

                            </div>

                        </div>


                        <div id="editTaskError"
                             class="task-form-error"
                             style="display:none;">
                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
    <!-- TASK DETAILS MODAL -->
    <div class="modal fade"
         id="taskDetailsModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content task-details-modal">

                <div class="modal-header">

                    <div>

                        <span class="task-detail-id"
                              id="detailTaskId">
                            TASK-0
                        </span>

                        <h5 class="modal-title"
                            id="detailTaskTitle">
                            Task Details
                        </h5>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="task-detail-grid">

                        <div>
                            <span>Status</span>
                            <strong id="detailTaskStatus">-</strong>
                        </div>

                        <div>
                            <span>Priority</span>
                            <strong id="detailTaskPriority">-</strong>
                        </div>

                        <div>
                            <span>Assigned To</span>
                            <strong id="detailTaskAssignee">-</strong>
                        </div>

                        <div>
                            <span>Amount</span>
                            <strong id="detailTaskAmount">-</strong>
                        </div>

                        <div>
                            <span>Start Date</span>
                            <strong id="detailTaskStart">-</strong>
                        </div>

                        <div>
                            <span>Expected End Date</span>
                            <strong id="detailTaskEnd">-</strong>
                        </div>

                    </div>


                    <div class="task-detail-scenario">

                        <span>Scenario</span>

                        <p id="detailTaskScenario">
                            -
                        </p>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- ALL TASKS MODAL -->
    <div class="modal fade"
         id="allTasksModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-xl">

            <div class="modal-content all-tasks-modal">

                <div class="modal-header">

                    <div>

                        <span class="all-task-label">
                            PROJECT TASKS
                        </span>

                        <h5 class="modal-title">
                            All Tasks
                        </h5>

                        <p class="all-task-subtitle">
                            Tasks belonging to this project
                        </p>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div id="allTasksContainer">
                    </div>

                </div>


                <div class="modal-footer">

                    <span id="allTasksCount"
                          class="all-task-count">
                        0 tasks
                    </span>

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                </div>

            </div>

        </div>

    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            window.projectTaskData = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                    Model ?? new List<TaskManagement.Application.DTOs.TaskDto>(),
                                    new System.Text.Json.JsonSerializerOptions
                                    {
                                            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                                    }
                            )
                    );

            window.currentProjectId = @projectId;
    </script>

    <script src="~/js/admin-tasks.js"
            asp-append-version="true">
    </script>
    <script src="~/js/admin-common.js"
        asp-append-version="true"></script>

</body>
</html>