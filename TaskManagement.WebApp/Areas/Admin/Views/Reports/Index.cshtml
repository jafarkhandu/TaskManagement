@model TaskManagement.Application.DTOs.AdminReportsViewModel
@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = "Reports";
    var completedPercent = Model.TotalTasks > 0
        ? Math.Round((double)Model.CompletedTasks / Model.TotalTasks * 100)
        : 0;

    var donutStops = new List<string>();
    var cumulativePercent = 0d;
    var donutColors = new[] { "20b987", "3164f4", "ef5350", "f5a623", "7856ed" };
    for (var i = 0; i < Model.StatusRows.Count; i++)
    {
        var row = Model.StatusRows[i];
        var start = cumulativePercent;
        cumulativePercent += row.Percent;
        donutStops.Add($"#{donutColors[i % donutColors.Length]} {start.ToString(CultureInfo.InvariantCulture)}% {cumulativePercent.ToString(CultureInfo.InvariantCulture)}%");
    }

    var donutGradient = donutStops.Count > 0
        ? $"conic-gradient(from -90deg, {string.Join(", ", donutStops)})"
        : "conic-gradient(#e9edf4 0 100%)";

    var statusColors = new[] { "green", "blue", "red", "orange", "purple" };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/ciit-logo.png" asp-append-version="true" />
    <title>Reports - TaskManager</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-reports.css" asp-append-version="true" />
</head>

<body class="admin-reports-page">
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")

    <main class="main-content">
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")

        <div class="reports-container">
            <section class="reports-toolbar">
                <div class="reports-heading">
                    <div class="reports-breadcrumb">
                        <span>ADMIN</span>
                        <span>/</span>
                        <strong>REPORTS</strong>
                    </div>
                    <h1>Reports</h1>
                    <p>Insights and analytics for your projects and team performance.</p>
                    <div id="reportPrintMeta" class="report-print-meta" aria-hidden="true"></div>
                </div>

                <div class="reports-actions">
                    <label class="range-control">
                        <span>Period</span>
                        <select id="reportRange" class="report-range" data-current-range="@Model.Range" aria-label="Report period">
                            <option value="all">All Time</option>
                            <option value="7">Last 7 Days</option>
                            <option value="30">Last 30 Days</option>
                            <option value="month">This Month</option>
                        </select>
                    </label>
                    <button type="button"
                            id="exportReport"
                            class="report-action primary"
                            aria-haspopup="dialog"
                            aria-controls="exportReportModal">
                        <span class="action-icon">↓</span>
                        Export Report
                    </button>
                </div>
            </section>

            <section class="report-summary">
                <article class="report-summary-card">
                    <div class="summary-label">
                        <span class="summary-icon blue">✓</span>
                        <span>Total Tasks</span>
                    </div>
                    <strong>@Model.TotalTasks</strong>
                    <small>All tasks in the selected period</small>
                </article>

                <article class="report-summary-card">
                    <div class="summary-label">
                        <span class="summary-icon purple">◷</span>
                        <span>In Progress</span>
                    </div>
                    <strong>@Model.InProgressTasks</strong>
                    <small>Tasks currently in progress</small>
                </article>

                <article class="report-summary-card">
                    <div class="summary-label">
                        <span class="summary-icon green">✓</span>
                        <span>Completed</span>
                    </div>
                    <strong>@Model.CompletedTasks</strong>
                    <small>@completedPercent% completion rate</small>
                </article>

                <article class="report-summary-card">
                    <div class="summary-label">
                        <span class="summary-icon red">!</span>
                        <span>On Hold</span>
                    </div>
                    <strong>@Model.OnHoldTasks</strong>
                    <small>Tasks currently on hold</small>
                </article>
            </section>

            <section class="reports-grid reports-grid-main">
                <article class="report-card status-card">
                    <div class="report-card-header">
                        <div>
                            <span class="report-card-eyebrow">WORKFLOW HEALTH</span>
                            <h2>Task status overview</h2>
                        </div>
                        <span class="report-card-meta">@Model.TotalTasks total</span>
                    </div>

                    <div class="status-analytics">
                        <div class="status-donut-wrap">
                            <div class="status-donut" style="background:@donutGradient" aria-label="Task status distribution">
                                <div class="status-donut-center">
                                    <strong>@Model.TotalTasks</strong>
                                    <span>Total Tasks</span>
                                </div>
                            </div>
                        </div>

                        <div class="status-legend">
                            @for (var i = 0; i < Model.StatusRows.Count; i++)
                            {
                                var row = Model.StatusRows[i];
                                <div class="status-legend-item">
                                    <div class="status-legend-label">
                                        <i class="status-dot @statusColors[i % statusColors.Length]"></i>
                                        <span>@row.Status</span>
                                    </div>
                                    <div class="status-legend-value">
                                        <strong>@row.Count</strong>
                                        <small>@row.Percent%</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </article>

                <article class="report-card project-card">
                    <div class="report-card-header">
                        <div>
                            <span class="report-card-eyebrow">DELIVERY</span>
                            <h2>Project performance</h2>
                        </div>
                        <span class="report-count">@Model.ProjectRows.Count projects</span>
                    </div>

                    <div class="report-table-wrap">
                        <table id="projectReportTable" class="report-table compact-table">
                            <thead>
                                <tr>
                                    <th>Project</th>
                                    <th>Tasks</th>
                                    <th>Completed</th>
                                    <th>In progress</th>
                                    <th>Overdue</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.ProjectRows.Any())
                            {
                                foreach (var row in Model.ProjectRows)
                                {
                                    var projectPercent = row.TaskCount > 0
                                        ? Math.Round((double)row.Completed / row.TaskCount * 100)
                                        : 0;
                                    var projectInitial = string.IsNullOrWhiteSpace(row.ProjectTitle)
                                        ? "P"
                                        : row.ProjectTitle.Substring(0, 1).ToUpper();

                                    <tr>
                                        <td>
                                            <div class="entity-cell">
                                                <span class="entity-avatar">@projectInitial</span>
                                                <strong>@row.ProjectTitle</strong>
                                            </div>
                                        </td>
                                        <td><span class="table-number">@row.TaskCount</span></td>
                                        <td><span class="metric-pill success">@row.Completed</span></td>
                                        <td><span class="metric-pill info">@row.InProgress</span></td>
                                        <td><span class="metric-pill danger">@row.Overdue</span></td>
                                        <td>
                                            <div class="progress-cell">
                                                <strong>@projectPercent%</strong>
                                                <div class="progress-track">
                                                    <span style="width:@projectPercent%"></span>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="report-empty">No project data for this period.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </article>
            </section>

            <section class="report-card full-card workload-card">
                <div class="report-card-header">
                    <div>
                        <span class="report-card-eyebrow">CAPACITY</span>
                        <h2>Student workload</h2>
                        <p class="report-card-description">Assigned work and completion across students represented in the report.</p>
                    </div>
                    <span class="report-count">@Model.StudentRows.Count students</span>
                </div>

                <div class="report-table-wrap">
                    <table id="studentReportTable" class="report-table workload-table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Assigned</th>
                                <th>Completed</th>
                                <th>Pending / active</th>
                                <th>Completion</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.StudentRows.Any())
                        {
                            foreach (var row in Model.StudentRows)
                            {
                                var studentPercent = row.Assigned > 0
                                    ? Math.Round((double)row.Completed / row.Assigned * 100)
                                    : 0;
                                var studentInitial = string.IsNullOrWhiteSpace(row.StudentName)
                                    ? "S"
                                    : row.StudentName.Substring(0, 1).ToUpper();

                                <tr>
                                    <td>
                                        <div class="entity-cell">
                                            <span class="entity-avatar person">@studentInitial</span>
                                            <strong>@row.StudentName</strong>
                                        </div>
                                    </td>
                                    <td><span class="table-number">@row.Assigned</span></td>
                                    <td><span class="metric-pill success">@row.Completed</span></td>
                                    <td><span class="metric-pill neutral">@row.Pending</span></td>
                                    <td>
                                        <div class="progress-cell">
                                            <strong>@studentPercent%</strong>
                                            <div class="progress-track">
                                                <span style="width:@studentPercent%"></span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="report-empty">No assigned student data for this period.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <div id="exportReportModal" class="report-export-modal" hidden aria-hidden="true">
        <div class="report-export-backdrop" data-export-close></div>
        <section class="report-export-dialog" role="dialog" aria-modal="true" aria-labelledby="exportReportTitle">
            <div class="report-export-header">
                <div>
                    <span class="report-export-eyebrow">REPORT EXPORT</span>
                    <h2 id="exportReportTitle">Export report</h2>
                    <p>Choose the format you want to export from the current report view.</p>
                </div>
                <button type="button" class="report-export-close" data-export-close aria-label="Close export report dialog">×</button>
            </div>
            <div class="report-export-options">
                <button type="button" class="report-export-option" data-export-format="pdf">
                    <span class="report-export-option-icon pdf">PDF</span>
                    <span class="report-export-option-copy">
                        <strong>Export as PDF</strong>
                        <small>Print the complete report with the current period, analytics and tables.</small>
                    </span>
                    <span class="report-export-option-arrow">→</span>
                </button>
                <button type="button" class="report-export-option" data-export-format="csv">
                    <span class="report-export-option-icon csv">CSV</span>
                    <span class="report-export-option-copy">
                        <strong>Export as CSV</strong>
                        <small>Download the report data in a spreadsheet-friendly format.</small>
                    </span>
                    <span class="report-export-option-arrow">→</span>
                </button>
            </div>
        </section>
    </div>

    <script src="~/js/admin/admin-reports.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-common.js" asp-append-version="true"></script>
</body>
</html>
