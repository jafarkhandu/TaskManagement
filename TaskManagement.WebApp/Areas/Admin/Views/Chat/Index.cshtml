@model IEnumerable<TaskManagement.Application.DTOs.AdminChatSessionDto>

@{
    ViewData["Title"] = "Admin Chat";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/ciit-logo.png" asp-append-version="true" />

    <title>TaskManager - Admin Chat</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/admin-common.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global-messages.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/admin-chat.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/theme.css"
          asp-append-version="true" />
</head>

<body class="admin-dashboard">

    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")

    <main class="main-content">

        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")

        <div class="dashboard-container admin-chat-page">

            <section class="admin-chat-layout">

                <!-- =====================================================
                     LEFT : CHAT LIST
                ====================================================== -->

                <div class="admin-chat-list-card">

                    <div class="admin-chat-list-header">

                        <div class="admin-chat-title-row">

                            <div>
                                <h2>Chats</h2>

                                <span id="adminChatUnreadCount"
                                      class="admin-chat-count"
                                      aria-label="Unread chat messages">
                                    @(Model?.Sum(x => x.UnreadCount) ?? 0)
                                </span>
                            </div>

                            <small class="admin-chat-date">
                                @DateTime.UtcNow.ToLocalTime().ToString("g")
                            </small>

                        </div>

                        <!-- Search -->
                        <div class="admin-chat-search">
                            <span class="admin-chat-search-icon">⌕</span>

                            <input type="text"
                                   id="chatSearchInput"
                                   placeholder="Search chats..."
                                   autocomplete="off" />
                        </div>

                        <!-- Filters -->
                        <div class="admin-chat-filters">

                            <button type="button"
                                    class="chat-filter active"
                                    data-filter="all">
                                All
                                <span class="filter-count">
                                    @(Model?.Count() ?? 0)
                                </span>
                            </button>

                            <button type="button"
                                    class="chat-filter"
                                    data-filter="unread">
                                Unread
                            </button>

                            <button type="button"
                                    class="chat-filter"
                                    data-filter="open">
                                Open
                            </button>

                            <button type="button"
                                    class="chat-filter"
                                    data-filter="hold">
                                On Hold
                            </button>

                        </div>

                    </div>


                    <!-- Chat list -->

                    <div id="adminChatList"
                         class="admin-chat-list">

                        @if (!Model?.Any() ?? true)
                        {
                            <div class="admin-chat-empty-list">
                                <strong>No active chats</strong>
                                <span>There are no active chat sessions.</span>
                            </div>
                        }
                        else
                        {
                            foreach (var group in (Model ?? Enumerable.Empty<TaskManagement.Application.DTOs.AdminChatSessionDto>())
                                .GroupBy(x => new { x.UserId, x.UserFullName })
                                .OrderBy(g => g.Key.UserFullName))
                            {
                                var userUnread = group.Sum(x => x.UnreadCount);

                                <section class="admin-chat-student-group collapsed"
                                         data-user-id="@group.Key.UserId">

                                    <button type="button"
                                            class="admin-chat-student-header"
                                            aria-expanded="false">

                                        <span class="student-avatar">
                                            @group.Key.UserFullName.FirstOrDefault().ToString().ToUpperInvariant()
                                        </span>

                                        <span class="student-header-content">
                                            <strong>@Html.Encode(group.Key.UserFullName)</strong>
                                            <small>
                                                @group.Count() @(group.Count() == 1 ? "conversation" : "conversations")
                                            </small>
                                        </span>

                                        <span class="student-header-right">
                                            @if (userUnread > 0)
                                            {
                                                <span class="student-unread">
                                                    @userUnread
                                                </span>
                                            }
                                            <span class="student-chevron">⌄</span>
                                        </span>
                                    </button>

                                    <div class="admin-chat-student-tasks" hidden>

                                        @foreach (var s in group
                                            .OrderByDescending(x => x.LatestMessageAt ?? DateTime.MinValue))
                                        {
                                            <div class="admin-chat-item"
                                                 data-chat-session-id="@s.ChatSessionId"
                                                 data-user-id="@s.UserId"
                                                 data-task-id="@s.TaskId"
                                                 data-project-id="@s.ProjectId"
                                                 data-status="@s.TaskStatus"
                                                 data-unread="@s.UnreadCount">

                                                <button type="button"
                                                        class="admin-chat-open"
                                                        aria-label="Open @Html.Encode(s.TaskTitle) chat">

                                                    <span class="chat-avatar task-chat-avatar">
                                                        <span class="chat-avatar-letter">
                                                            @s.TaskTitle.FirstOrDefault().ToString().ToUpperInvariant()
                                                        </span>
                                                    </span>

                                                    <span class="chat-item-content">

                                                        <span class="chat-item-top">
                                                            <span class="admin-chat-username">
                                                                @Html.Encode(s.TaskTitle)
                                                            </span>

                                                            <small class="admin-chat-time">
                                                                @(s.LatestMessageAt.HasValue
                                                                    ? s.LatestMessageAt.Value.ToLocalTime().ToString("g")
                                                                    : "—")
                                                            </small>
                                                        </span>

                                                        <span class="chat-item-message-row">
                                                            <span class="admin-chat-preview">
                                                                @Html.Encode(s.LatestMessage)
                                                            </span>

                                                            @if (s.UnreadCount > 0)
                                                            {
                                                                <span class="admin-chat-badge">
                                                                    @s.UnreadCount
                                                                </span>
                                                            }
                                                        </span>

                                                        <span class="chat-item-meta">
                                                            <span class="chat-project">
                                                                Project: @Html.Encode(s.ProjectTitle)
                                                            </span>

                                                            <span class="chat-status">
                                                                @Html.Encode(s.TaskStatus)
                                                            </span>
                                                        </span>

                                                    </span>
                                                </button>

                                                <button type="button"
                                                        class="admin-chat-delete"
                                                        title="Delete chat"
                                                        aria-label="Delete @Html.Encode(s.TaskTitle) chat">
                                                    <span aria-hidden="true">🗑</span>
                                                </button>
                                            </div>
                                        }

                                    </div>
                                </section>
                            }
                        }

                    </div>

                </div>


                <!-- =====================================================
                     RIGHT : CHAT PANEL
                ====================================================== -->

                <div class="admin-chat-panel-wrapper">

                    <aside id="adminChatDrawer"
                           class="admin-chat-drawer"
                           aria-hidden="true">

                        <!-- Header -->

                        <div class="admin-chat-header">

                            <div class="admin-chat-user-info">

                                <div class="chat-header-avatar">
                                    <span id="drawerUserInitial">U</span>
                                </div>

                                <div>

                                    <div id="drawerUserName"
                                         class="drawer-user-name">
                                        Select a chat
                                    </div>

                                    <div id="drawerContext"
                                         class="drawer-context">
                                        Select a conversation from the list
                                    </div>

                                </div>

                            </div>

                            <button type="button"
                                    id="closeAdminChat"
                                    class="chat-close-button"
                                    aria-label="Close chat">
                                ×
                            </button>

                        </div>


                        <!-- Messages -->

                        <div id="adminChatMessages"
                             class="admin-chat-messages">

                            <div class="chat-placeholder">

                                <div class="chat-placeholder-icon">
                                    💬
                                </div>

                                <strong>Select a chat</strong>

                                <span>
                                    Choose a conversation from the left to view messages.
                                </span>

                            </div>

                        </div>


                        <!-- Composer -->

                        <div class="admin-chat-composer">

                            <textarea id="adminChatInput"
                                      rows="1"
                                      class="admin-chat-input"
                                      placeholder="Type a message..."
                                      autocomplete="off"></textarea>

                            <button id="adminSendChat"
                                    type="button"
                                    class="admin-send-button"
                                    disabled>
                                Send
                            </button>

                        </div>

                    </aside>

                </div>

            </section>

        </div>

    </main>


    <!-- Anti-forgery token -->
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>


    <!-- Existing scripts - KEEP -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.5/dist/browser/signalr.min.js"></script>

    <script src="~/js/admin/admin-chat.js"
            asp-append-version="true"></script>

    <script src="~/js/admin/admin-tasks.js"
            asp-append-version="true"></script>

    <script src="~/js/admin/admin-common.js"
            asp-append-version="true"></script>
    <script src="~/js/global-messages.js" asp-append-version="true"></script>

</body>

</html>