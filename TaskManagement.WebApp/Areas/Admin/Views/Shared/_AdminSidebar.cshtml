@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
}

<aside class="sidebar">

    <!-- BRAND -->
    <div class="sidebar-brand">
        <img src="~/images/ciit-logo.png"
             alt="CIIT Training Institute"
             class="sidebar-brand-image" />
    </div>

    <!-- NAVIGATION -->
    <nav class="sidebar-nav">

        <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
           class="sidebar-link @(currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <span class="nav-icon">⌂</span>
            <span>Dashboard</span>
        </a>

        <a href="@Url.Action("Index", "Chat", new { area = "Admin" })"
           class="sidebar-link @(currentController.Equals("Chat", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
           id="adminChatSidebarLink">
            <span class="nav-icon">✉</span>
            <span>Chat</span>
            <span id="adminChatSidebarDot"
                  class="admin-chat-sidebar-dot"
                  hidden
                  aria-label="New chat message"></span>
        </a>

        <a href="@Url.Action("Index", "TaskReviews", new { area = "Admin" })"
           class="sidebar-link @(currentController.Equals("TaskReviews", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <span class="nav-icon">✓</span>
            <span>Task Reviews</span>
        </a>

        <a href="@Url.Action("Index", "Projects", new { area = "Admin" })"
           class="sidebar-link @(currentController.Equals("Projects", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <span class="nav-icon">▣</span>
            <span>Projects</span>
        </a>

        <a href="@Url.Action("Index", "Users", new { area = "Admin" })"
           class="sidebar-link @(currentController.Equals("Users", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <span class="nav-icon">♙</span>
            <span>Users</span>
        </a>

        <a href="#"
           class="sidebar-link @(currentController.Equals("Calendar", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <span class="nav-icon">▣</span>
            <span>Calendar</span>
        </a>

        <a href="@Url.Action("Index", "Reports", new { area = "Admin" })"
           class="sidebar-link @(currentController.Equals("Reports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <span class="nav-icon">▥</span>
            <span>Reports</span>
        </a>

        <a href="#"
           class="sidebar-link @(currentController.Equals("Settings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <span class="nav-icon">⚙</span>
            <span>Settings</span>
        </a>

    </nav>

    <!-- LOGOUT -->
    <form class="sidebar-logout-form"
          action="@Url.Action("Logout", "Account", new { area = "" })"
          method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="sidebar-logout-button">
            <span class="logout-icon">↪</span>
            <span>Logout</span>
        </button>
    </form>

</aside>
