@model TaskManagement.Application.DTOs.LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login-CIIT INSTITUTE</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/account/account.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/global-messages.css"
          asp-append-version="true" />
</head>

<body class="account-page">

    <div class="account-wrapper">

        <!-- LEFT SIDE -->
        <section class="account-brand-panel">

            <div class="brand-content">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="brand-logo text-decoration-none">

                    <span class="brand-icon">
                        ✓
                    </span>

                    <span>
                        <strong>CIIT INSTITUTE</strong>
                        <small>Plan · Track · Grow</small>
                    </span>

                </a>

                <div class="brand-message">

                    <span class="eyebrow">
                        WORK SMARTER
                    </span>

                    <h1>
                        Manage your work.
                        <br />
                        Achieve more.
                    </h1>

                    <p>
                        Organize tasks, collaborate with your team,
                        and keep every project moving forward.
                    </p>

                    <div class="feature-list">

                        <div class="feature-item">
                            <span class="feature-icon">✓</span>
                            <div>
                                <strong>Stay organized</strong>
                                <small>Keep all your tasks in one place.</small>
                            </div>
                        </div>

                        <div class="feature-item">
                            <span class="feature-icon">↗</span>
                            <div>
                                <strong>Track progress</strong>
                                <small>Know what needs your attention.</small>
                            </div>
                        </div>

                        <div class="feature-item">
                            <span class="feature-icon">+</span>
                            <div>
                                <strong>Work together</strong>
                                <small>Collaborate and get things done.</small>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <div class="brand-footer">
                © 2026 TaskManager. Built for productive teams.
            </div>

        </section>


        <!-- RIGHT SIDE -->
        <section class="account-form-panel">

            <div class="form-container">

                <div class="mobile-brand">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="brand-logo text-decoration-none">

                        <span class="brand-icon">
                            ✓
                        </span>

                        <span>
                            <strong>TaskManager</strong>
                            <small>Plan · Track · Grow</small>
                        </span>

                    </a>

                </div>


                <div class="form-header">

                    <div class="form-icon">
                        <span>↪</span>
                    </div>

                    <h2>Welcome back</h2>

                    <p>
                        Sign in to continue to your workspace
                    </p>

                </div>


                <!-- MESSAGE -->
                <div id="loginMessage"
                     class="alert d-none account-alert"
                     role="alert">
                </div>


                <form id="loginForm"
                      novalidate>

                    @Html.AntiForgeryToken()

                    <!-- EMAIL -->
                    <div class="mb-3">

                        <label for="Email"
                               class="form-label">
                            Email address
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                ✉
                            </span>

                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   autocomplete="email"
                                   required />

                        </div>

                        <div id="emailError"
                             class="field-error">
                        </div>

                    </div>


                    <!-- PASSWORD -->
                    <div class="mb-3">

                        <div class="d-flex justify-content-between">

                            <label for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <button type="button"
                                    id="forgotPasswordLink"
                                    class="forgot-password-link">
                                Forgot password?
                            </button>

                        </div>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                🔒
                            </span>

                            <input type="password"
                                   id="Password"
                                   name="Password"
                                   class="form-control password-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    id="togglePassword"
                                    class="password-toggle"
                                    aria-label="Show password">

                                ◉

                            </button>

                        </div>

                        <div id="passwordError"
                             class="field-error">
                        </div>

                    </div>


                    <!-- REMEMBER -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">

                            <input type="checkbox"
                                   id="RememberMe"
                                   name="RememberMe"
                                   class="form-check-input" />

                            <label for="RememberMe"
                                   class="form-check-label">
                                Remember me
                            </label>

                        </div>

                    </div>


                    <!-- LOGIN BUTTON -->
                    <button type="submit"
                            id="loginButton"
                            class="btn account-btn w-100">

                        <span id="loginButtonText">
                            Sign in
                        </span>

                        <span id="loginSpinner"
                              class="spinner-border spinner-border-sm d-none"
                              role="status"
                              aria-hidden="true">
                        </span>

                    </button>

                </form>


                <!-- FORGOT PASSWORD -->
                <div id="forgotPasswordPanel"
                     class="forgot-password-panel d-none"
                     aria-hidden="true">

                    <div class="forgot-panel-header">
                        <button type="button"
                                id="forgotBackButton"
                                class="forgot-back-button">
                            ← Back to login
                        </button>

                        <div class="form-icon forgot-form-icon"><span>🔐</span></div>
                        <h3 id="forgotPanelTitle">Forgot password?</h3>
                        <p id="forgotPanelSubtitle">Enter your registered email and we'll send you a verification OTP.</p>
                    </div>

                    <div id="forgotMessage" class="alert d-none account-alert" role="alert"></div>

                    <div id="forgotStepEmail" class="forgot-step">
                        <label for="forgotEmail" class="form-label">Registered email</label>
                        <div class="input-wrapper">
                            <span class="input-icon">✉</span>
                            <input type="email" id="forgotEmail" class="form-control"
                                   placeholder="Enter your registered email" autocomplete="email" />
                        </div>
                        <button type="button" id="sendForgotOtpButton" class="btn account-btn w-100 mt-3">
                            <span id="sendForgotOtpText">Send OTP</span>
                            <span id="sendForgotOtpSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>
                    </div>

                    <div id="forgotStepOtp" class="forgot-step d-none">
                        <label class="form-label">Verification OTP</label>
                        <div class="otp-input-group">
                            <input type="text" maxlength="1" inputmode="numeric" class="otp-input" />
                            <input type="text" maxlength="1" inputmode="numeric" class="otp-input" />
                            <input type="text" maxlength="1" inputmode="numeric" class="otp-input" />
                            <input type="text" maxlength="1" inputmode="numeric" class="otp-input" />
                            <input type="text" maxlength="1" inputmode="numeric" class="otp-input" />
                            <input type="text" maxlength="1" inputmode="numeric" class="otp-input" />
                        </div>
                        <div class="otp-meta">
                            <span id="otpCountdown">OTP expires in 10:00</span>
                            <button type="button" id="resendForgotOtpButton" class="forgot-resend-button" disabled>Resend OTP</button>
                        </div>
                        <button type="button" id="verifyForgotOtpButton" class="btn account-btn w-100 mt-3">Verify OTP</button>
                    </div>

                    <div id="forgotStepReset" class="forgot-step d-none">
                        <label for="forgotNewPassword" class="form-label">New password</label>
                        <div class="input-wrapper">
                            <span class="input-icon">🔒</span>
                            <input type="password" id="forgotNewPassword" class="form-control"
                                   autocomplete="new-password" placeholder="Enter new password" />
                            <button type="button" id="toggleForgotNewPassword"
                                    class="password-toggle forgot-password-toggle"
                                    aria-label="Show password" title="Show password">◉</button>
                        </div>
                        <label for="forgotConfirmPassword" class="form-label mt-3">Confirm password</label>
                        <div class="input-wrapper">
                            <span class="input-icon">🔒</span>
                            <input type="password" id="forgotConfirmPassword" class="form-control"
                                   autocomplete="new-password" placeholder="Confirm new password" />
                            <button type="button" id="toggleForgotConfirmPassword"
                                    class="password-toggle forgot-password-toggle"
                                    aria-label="Show password" title="Show password">◉</button>
                        </div>
                        <button type="button" id="resetForgotPasswordButton" class="btn account-btn w-100 mt-3">Reset Password</button>
                    </div>
                </div>

                <!-- REGISTER -->
                <div class="form-bottom">

                    <span>
                        Don't have an account?
                    </span>

                    <a asp-controller="Account"
                       asp-action="Register">
                        Create an account
                    </a>

                </div>


                <div class="security-note">

                    <span>🔐</span>

                    <span>
                        Your account is protected with secure authentication.
                    </span>

                </div>

            </div>

        </section>

    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/account/login.js"
            asp-append-version="true">
    </script>

    <script src="~/js/account/forgot-password.js"
            asp-append-version="true">
    </script>

    <script src="~/js/global-messages.js"
            asp-append-version="true">
    </script>

</body>
</html>